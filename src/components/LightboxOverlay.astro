---
// Image lightbox / slideshow viewer.
// Activates on any element with data-lightbox-src.
// Items grouped by data-lightbox-group navigate together.
// Optional data-lightbox-caption appears below the image.
---

<div id="lightbox-overlay" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Image viewer">
  <div data-lightbox-backdrop></div>
  <div data-lightbox-counter aria-live="polite" hidden></div>
  <button type="button" data-lightbox-close aria-label="Close" title="Close (Esc)">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75">
      <path d="M4 4l12 12M16 4L4 16" />
    </svg>
  </button>
  <button type="button" data-lightbox-prev aria-label="Previous image" title="Previous (←)" hidden>
    <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.75">
      <path d="M14 4l-7 7 7 7" />
    </svg>
  </button>
  <figure data-lightbox-figure>
    <img data-lightbox-image alt="" />
    <figcaption data-lightbox-caption hidden></figcaption>
  </figure>
  <button type="button" data-lightbox-next aria-label="Next image" title="Next (→)" hidden>
    <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.75">
      <path d="M8 4l7 7-7 7" />
    </svg>
  </button>
</div>

<style>
  #lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
  }
  #lightbox-overlay:not([hidden]) {
    display: flex;
  }
  [data-lightbox-backdrop] {
    position: absolute;
    inset: 0;
    background: rgba(26, 24, 21, 0.96);
  }
  [data-lightbox-figure] {
    position: relative;
    z-index: 1;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: min(90vw, 1400px);
    max-height: 90vh;
  }
  [data-lightbox-image] {
    max-width: 100%;
    max-height: calc(90vh - 3rem);
    object-fit: contain;
    display: block;
    background: rgba(247, 242, 232, 0.04);
  }
  [data-lightbox-caption] {
    color: #f7f2e8;
    font-family: 'DM Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-top: 1rem;
    text-align: center;
    max-width: 60ch;
    line-height: 1.5;
  }
  [data-lightbox-prev],
  [data-lightbox-next],
  [data-lightbox-close] {
    position: relative;
    z-index: 2;
    background: transparent;
    border: 1px solid rgba(247, 242, 232, 0.25);
    color: #f7f2e8;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.15s, border-color 0.15s, transform 0.1s;
    padding: 0;
    flex-shrink: 0;
  }
  [data-lightbox-prev]:hover,
  [data-lightbox-next]:hover,
  [data-lightbox-close]:hover {
    background: rgba(247, 242, 232, 0.1);
    border-color: rgba(247, 242, 232, 0.6);
  }
  [data-lightbox-prev]:active,
  [data-lightbox-next]:active,
  [data-lightbox-close]:active {
    transform: scale(0.95);
  }
  [data-lightbox-prev] {
    margin-right: 1rem;
  }
  [data-lightbox-next] {
    margin-left: 1rem;
  }
  [data-lightbox-counter] {
    position: absolute;
    top: 24px;
    left: 28px;
    z-index: 2;
    color: rgba(247, 242, 232, 0.85);
    font-family: 'DM Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
  }
  [data-lightbox-close] {
    position: absolute;
    top: 20px;
    right: 24px;
  }
  /* Hide nav buttons inline when not needed; keep close + counter floating */
  [data-lightbox-prev][hidden],
  [data-lightbox-next][hidden],
  [data-lightbox-counter][hidden],
  [data-lightbox-caption][hidden] {
    display: none;
  }
  @media (max-width: 640px) {
    [data-lightbox-prev],
    [data-lightbox-next] {
      width: 38px;
      height: 38px;
      margin: 0 0.5rem;
    }
    [data-lightbox-counter] { top: 16px; left: 18px; }
    [data-lightbox-close] { top: 14px; right: 18px; }
  }
</style>

<script is:inline>
  (() => {
    const overlay = document.getElementById('lightbox-overlay');
    if (!overlay) return;
    const items = document.querySelectorAll('[data-lightbox-src]');
    if (!items.length) return;

    const imgEl = overlay.querySelector('[data-lightbox-image]');
    const captionEl = overlay.querySelector('[data-lightbox-caption]');
    const counterEl = overlay.querySelector('[data-lightbox-counter]');
    const prevBtn = overlay.querySelector('[data-lightbox-prev]');
    const nextBtn = overlay.querySelector('[data-lightbox-next]');
    const closeBtn = overlay.querySelector('[data-lightbox-close]');
    const backdrop = overlay.querySelector('[data-lightbox-backdrop]');

    const groups = new Map();
    items.forEach((el) => {
      const id = el.dataset.lightboxGroup || '_default';
      if (!groups.has(id)) groups.set(id, []);
      groups.get(id).push(el);
    });

    let group = [];
    let i = 0;
    let lastFocus = null;
    let savedOverflow = '';

    const render = () => {
      const item = group[i];
      imgEl.src = item.dataset.lightboxSrc || '';
      imgEl.alt = item.dataset.lightboxCaption || '';
      const caption = item.dataset.lightboxCaption || '';
      captionEl.textContent = caption;
      captionEl.hidden = !caption;
      counterEl.textContent = `${i + 1} / ${group.length}`;
      counterEl.hidden = group.length < 2;
      prevBtn.hidden = group.length < 2;
      nextBtn.hidden = group.length < 2;
    };

    const open = (g, idx) => {
      group = g; i = idx;
      lastFocus = document.activeElement;
      savedOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      overlay.hidden = false;
      overlay.setAttribute('aria-hidden', 'false');
      render();
      closeBtn.focus({ preventScroll: true });
    };

    const close = () => {
      overlay.hidden = true;
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = savedOverflow;
      imgEl.src = '';
      if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus({ preventScroll: true });
    };

    const next = () => { if (group.length > 1) { i = (i + 1) % group.length; render(); } };
    const prev = () => { if (group.length > 1) { i = (i - 1 + group.length) % group.length; render(); } };

    items.forEach((el) => {
      el.style.cursor = 'zoom-in';
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const id = el.dataset.lightboxGroup || '_default';
        const g = groups.get(id);
        open(g, g.indexOf(el));
      });
    });

    closeBtn.addEventListener('click', close);
    backdrop.addEventListener('click', close);
    nextBtn.addEventListener('click', next);
    prevBtn.addEventListener('click', prev);

    document.addEventListener('keydown', (e) => {
      if (overlay.hidden) return;
      if (e.key === 'Escape') { e.preventDefault(); close(); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); next(); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); prev(); }
    });

    let touchX = null;
    overlay.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
    overlay.addEventListener('touchend', (e) => {
      if (touchX === null) return;
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 50) (dx < 0 ? next : prev)();
      touchX = null;
    }, { passive: true });
  })();
</script>
