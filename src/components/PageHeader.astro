---
import { splitAccentWord } from '../utils/accentWord';

export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  /** Optional accent for an italic word in the title — wraps the matching word in display-italic + accent color. */
  accentWord?: string;
}
const { eyebrow, title, subtitle, align = 'left', accentWord } = Astro.props;

const t = splitAccentWord(title, accentWord);
---

<section class={`bg-paper ${align === 'center' ? 'text-center' : ''}`}>
  <div class="container-content pt-20 md:pt-28 pb-10 md:pb-14">
    {eyebrow && (
      <div class={`eyebrow ${align === 'center' ? 'justify-center' : ''}`}>
        <span>{eyebrow}</span>
      </div>
    )}
    <h1
      class={`display text-fluid-4 leading-[0.98] tracking-display-tight text-ink m-0 ${align === 'center' ? 'mx-auto max-w-4xl' : 'max-w-5xl'}`}
    >
      {t ? (<>{t.before}<span class="display-italic text-accent">{t.word}</span>{t.after}</>) : title}
    </h1>
    {subtitle && (
      <p class={`mt-7 text-lg md:text-xl leading-relaxed text-ink-2 ${align === 'center' ? 'mx-auto max-w-3xl' : 'max-w-3xl'}`}>
        {subtitle}
      </p>
    )}
  </div>
</section>
