---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  /** Optional accent for an italic word in the title — wraps the matching word in display-italic + accent color. */
  accentWord?: string;
}
const { eyebrow, title, subtitle, align = 'left', accentWord } = Astro.props;

const renderTitle = () => {
  if (!accentWord) return title;
  // Wrap the first occurrence of `accentWord` in <em class="display-italic text-accent">…</em>
  const idx = title.toLowerCase().indexOf(accentWord.toLowerCase());
  if (idx === -1) return title;
  return {
    before: title.slice(0, idx),
    word: title.slice(idx, idx + accentWord.length),
    after: title.slice(idx + accentWord.length),
  };
};
const t = renderTitle();
---

<section class={`bg-paper ${align === 'center' ? 'text-center' : ''}`}>
  <div class="container-content pt-20 md:pt-28 pb-10 md:pb-14">
    {eyebrow && (
      <div class={`eyebrow ${align === 'center' ? 'justify-center' : ''}`}>
        <span>{eyebrow}</span>
      </div>
    )}
    <h1
      class={`display text-[clamp(2.75rem,6vw,5.5rem)] leading-[0.98] tracking-display-tight text-ink m-0 ${align === 'center' ? 'mx-auto max-w-4xl' : 'max-w-5xl'}`}
    >
      {typeof t === 'string' ? title : (<><Fragment set:html={t.before} /><span class="display-italic text-accent">{t.word}</span><Fragment set:html={t.after} /></>)}
    </h1>
    {subtitle && (
      <p class={`mt-7 text-lg md:text-xl leading-relaxed text-ink-2 ${align === 'center' ? 'mx-auto max-w-3xl' : 'max-w-3xl'}`}>
        {subtitle}
      </p>
    )}
  </div>
</section>
