---
export interface Props {
  value: string;
  label: string;
  description?: string;
  eyebrow?: string;
}
const { value, label, description, eyebrow } = Astro.props;
---

<div>
  {eyebrow && (
    <div class="eyebrow">
      <span>{eyebrow}</span>
    </div>
  )}
  <p class="display text-[clamp(2.25rem,9vw,5.5rem)] leading-[0.95] tracking-[-0.045em] text-ink break-words">{value}</p>
  <p class="mt-3 text-[15px] text-ink-2 max-w-[16rem] leading-snug">{label}</p>
  {description && <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-3">{description}</p>}
</div>
