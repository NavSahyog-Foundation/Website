---
export interface Props {
  value: string;
  label: string;
  description?: string;
}
const { value, label, description } = Astro.props;
---

<div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
  <p class="text-4xl md:text-5xl font-bold text-brand">{value}</p>
  <p class="mt-2 text-ink font-semibold">{label}</p>
  {description && <p class="mt-1 text-sm text-ink/70">{description}</p>}
</div>
