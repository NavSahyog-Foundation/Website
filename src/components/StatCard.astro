---
export interface Props {
  value: string;
  label: string;
  description?: string;
  eyebrow?: string;
}
const { value, label, description, eyebrow } = Astro.props;
---

<div>
  {eyebrow && (
    <div class="eyebrow">
      <span>{eyebrow}</span>
    </div>
  )}
  <p class="display text-fluid-stat leading-[0.95] tracking-[-0.045em] text-ink whitespace-nowrap">{value}</p>
  <p class="mt-3 text-[15px] text-ink-2 max-w-[16rem] leading-snug">{label}</p>
  {description && <p class="label-mono mt-2 tracking-label-12 text-ink-3">{description}</p>}
</div>
