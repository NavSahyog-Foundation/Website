---
import { Image } from 'astro:assets';
import { media } from '../utils/media';

export interface Props {
  src: string;
  alt?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt = '', class: className = '', loading = 'lazy' } = Astro.props;
const img = media(src);
---

{img && <Image src={img} alt={alt} class={className} loading={loading} />}
