---
import { url } from '../utils/url';

const nav = [
  {
    label: 'About',
    children: [
      { label: 'Our Story', href: url('/about/our-story/') },
      { label: 'The Five Factors', href: url('/about/five-factors/') },
      { label: 'The Team', href: url('/about/the-team/') },
    ],
  },
  {
    label: 'Our Work',
    children: [
      { label: 'The Big Problem', href: url('/program/big-problem/') },
      { label: 'Intervention', href: url('/program/intervention/') },
      { label: 'Projects', href: url('/program/projects/') },
      { label: 'Jal Vriddhi', href: url('/program/jal-vriddhi/') },
      { label: 'Presence', href: url('/program/presence/') },
    ],
  },
  {
    label: 'Impact',
    children: [
      { label: 'Impact', href: url('/impact/') },
      { label: 'Testimonials', href: url('/impact/testimonials/') },
    ],
  },
  {
    label: 'Support Us',
    href: url('/support/'),
    children: [
      { label: 'Donate', href: url('/donate/') },
      { label: 'Partners', href: url('/program/partners/') },
      { label: 'Our Donors', href: url('/program/donors/') },
      { label: 'Contact', href: url('/contact/') },
    ],
  },
  {
    label: 'News & Stories',
    href: url('/news/'),
  },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || (currentPath.startsWith(href) && href !== url('/'));
const sectionActive = (item: any) => item.children?.some((c: any) => isActive(c.href)) || (item.href && isActive(item.href));
---

<header class="sticky top-0 z-40 bg-paper/90 backdrop-blur-md border-b border-line">
  <div class="container-content flex items-center justify-between gap-2 sm:gap-3 md:gap-4 py-4 md:py-5">
    <a href={url('/')} class="flex items-baseline gap-1 sm:gap-2 min-w-0 flex-1 lg:flex-initial" aria-label="NavSahyog Foundation — Home">
      <span class="display text-[19px] sm:text-2xl md:text-[26px] font-semibold text-ink leading-none tracking-display-tight whitespace-nowrap">NavSahyog</span>
      <span class="hidden sm:inline display-italic sm:text-2xl md:text-[26px] text-accent leading-none whitespace-nowrap">Foundation</span>
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
      {nav.map((item) =>
        item.children ? (
          <div class="relative group">
            <a
              href={item.href}
              class:list={[
                'px-3.5 py-2.5 text-sm font-medium tracking-tight inline-flex items-center gap-1 border-b-[1.5px] -mb-px',
                sectionActive(item)
                  ? 'text-accent border-accent'
                  : 'text-ink border-transparent hover:text-accent',
              ]}
              aria-haspopup="true"
            >
              {item.label}
              <svg class="w-3 h-3" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
                <path d="M6 8.5 1.5 4h9L6 8.5z" />
              </svg>
            </a>
            <div class="absolute left-0 top-full pt-2 hidden group-hover:block group-focus-within:block">
              <div class="bg-white border border-line shadow-[0_12px_40px_-12px_rgba(0,0,0,0.15)] py-2 min-w-[14rem]">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class:list={[
                      'block px-4 py-2.5 text-[13.5px] font-medium hover:bg-paper-alt hover:text-accent',
                      isActive(child.href) ? 'text-accent' : 'text-ink-2',
                    ]}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class:list={[
              'px-3.5 py-2.5 text-sm font-medium tracking-tight border-b-[1.5px] -mb-px',
              sectionActive(item)
                ? 'text-accent border-accent'
                : 'text-ink border-transparent hover:text-accent',
            ]}
          >
            {item.label}
          </a>
        ),
      )}
      <a href={url('/donate/')} class="ml-3 inline-flex items-center gap-1.5 bg-accent text-white px-4 py-2.5 rounded-full text-[13.5px] font-semibold hover:bg-accent-deep hover:-translate-y-px transition-all">
        Donate <span aria-hidden="true">→</span>
      </a>
    </nav>

    <div class="flex items-center gap-0.5 sm:gap-2 lg:hidden shrink-0">
      <a href={url('/donate/')} class="inline-flex items-center gap-1.5 bg-accent text-white px-3 py-1.5 sm:px-4 sm:py-2 rounded-full text-eyebrow-lg sm:text-[13px] font-semibold">
        Donate
      </a>
      <button
        type="button"
        id="mobile-menu-toggle"
        class="p-2 -mr-1 sm:mr-0 text-ink hover:text-accent"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-line bg-paper">
    <nav class="container-content py-3 space-y-1" aria-label="Mobile">
      {nav.map((item) =>
        item.children ? (
          <details class="group border-b border-line">
            <summary class="flex items-center justify-between px-2 py-3 text-sm font-semibold text-ink cursor-pointer list-none">
              {item.label}
              <svg class="w-3 h-3 group-open:rotate-180 transition" viewBox="0 0 12 12" fill="currentColor">
                <path d="M6 8.5 1.5 4h9L6 8.5z" />
              </svg>
            </summary>
            <div class="pl-4 py-2 space-y-1">
              {item.href && (
                <a href={item.href} class="block px-2 py-2 text-sm font-medium text-accent">{item.label} overview →</a>
              )}
              {item.children.map((child) => (
                <a href={child.href} class="block px-2 py-2 text-sm text-ink-2 hover:text-accent">
                  {child.label}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a href={item.href} class="block px-2 py-3 text-sm font-semibold text-ink hover:text-accent border-b border-line">
            {item.label}
          </a>
        ),
      )}
    </nav>
  </div>
</header>

<script is:inline>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
