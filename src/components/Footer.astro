---
import { url } from '../utils/url';

const year = new Date().getFullYear();

const cols = [
  {
    title: 'About',
    items: [
      { label: 'Our Story', href: url('/about/our-story/') },
      { label: 'The Five Factors', href: url('/about/five-factors/') },
      { label: 'The Team', href: url('/about/the-team/') },
    ],
  },
  {
    title: 'Our Work',
    items: [
      { label: 'Intervention', href: url('/program/intervention/') },
      { label: 'Projects', href: url('/program/projects/') },
      { label: 'Jal Vriddhi', href: url('/program/jal-vriddhi/') },
      { label: 'Presence', href: url('/program/presence/') },
      { label: 'Impact', href: url('/impact/') },
    ],
  },
  {
    title: 'Support',
    items: [
      { label: 'Donate', href: url('/donate/') },
      { label: 'Partners', href: url('/program/partners/') },
      { label: 'Our Donors', href: url('/program/donors/') },
      { label: 'Contact', href: url('/contact/') },
    ],
  },
  {
    title: 'More',
    items: [
      { label: 'News & Stories', href: url('/news/') },
      { label: 'Downloads', href: url('/downloads/') },
      { label: 'Covid-19 Relief', href: url('/covid-19-relief/') },
    ],
  },
];

const social = [
  { label: 'Facebook', href: 'https://www.facebook.com/navsahyogfoundation/' },
  { label: 'Instagram', href: 'https://www.instagram.com/navsahyogfoundation/' },
  { label: 'YouTube', href: 'https://www.youtube.com/channel/UCOzO0-ZWLIOWjxU2SWwr7OA' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/navsahyog-foundation/' },
];
---

<footer class="bg-ink text-paper mt-24">
  <div class="container-content pt-20 pb-10">
    <div class="grid md:grid-cols-[2fr_repeat(4,1fr)] gap-10 md:gap-12 mb-16">
      <div>
        <div class="display text-3xl font-semibold tracking-display-tight mb-4">NavSahyog Foundation</div>
        <p class="text-15 leading-relaxed text-paper/75 max-w-md">
          Developing life skills and creativity in village children, ages 5–14 — every day from
          Monday to Saturday — across 350+ villages in Karnataka, Tamil Nadu and Nagaland.
        </p>
        <div class="flex flex-wrap gap-2.5 mt-6">
          {social.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              class="text-xs px-3 py-1.5 border border-paper/25 rounded-full text-paper/85 hover:border-accent hover:text-accent transition-colors"
            >
              {s.label}
            </a>
          ))}
        </div>
        <address class="not-italic text-sm text-paper/70 mt-8 space-y-1.5 leading-relaxed">
          <p>B-104, Shobha Garnet,<br />Sarjapur Road, Iblur,<br />Bengaluru – 560102</p>
          <p>
            <a href="mailto:paritosh.segal@gmail.com" class="hover:text-accent">paritosh.segal@gmail.com</a>
          </p>
          <p>
            <a href="tel:+919886624000" class="hover:text-accent">+91 98866 24000</a>
          </p>
        </address>
      </div>
      {cols.map((col) => (
        <div>
          <div class="label-mono tracking-label-16 font-bold text-paper/50 mb-5">{col.title}</div>
          <ul class="space-y-3">
            {col.items.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-paper/85 hover:text-accent">{item.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="border-t border-paper/15 pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
      <p class="font-mono text-paper/55">© {year} NavSahyog Foundation · Section 8 Company · 80G &amp; FCRA registered</p>
      <p class="font-mono text-paper/55">www.navsahyog.org</p>
    </div>
  </div>
</footer>
