---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo-tagline.png';

const year = new Date().getFullYear();
---

<footer class="bg-surface-dark text-white mt-24">
  <div class="container-content py-14 grid md:grid-cols-4 gap-10">
    <div class="md:col-span-2">
      <Image src={logo} alt="NavSahyog Foundation" class="h-16 w-auto bg-white rounded p-2 mb-4" />
      <p class="text-white/80 text-sm leading-relaxed max-w-md">
        NavSahyog Foundation develops life skills and creativity in village children aged 5–14, and
        builds linkages to livelihood for rural youth — a path from life skills to livelihood.
      </p>
      <div class="flex gap-3 mt-5">
        <a
          href="https://www.youtube.com/channel/UCOzO0-ZWLIOWjxU2SWwr7OA"
          target="_blank"
          rel="noopener"
          aria-label="YouTube"
          class="p-2 rounded-full bg-white/10 hover:bg-brand"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg>
        </a>
        <a
          href="https://www.linkedin.com/company/navsahyog-foundation/"
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn"
          class="p-2 rounded-full bg-white/10 hover:bg-brand"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.1a4.2 4.2 0 0 1 3.8-2.1c4 0 4.8 2.6 4.8 6V21h-4v-5.8c0-1.4 0-3.1-1.9-3.1-1.9 0-2.2 1.5-2.2 3V21h-4V9Z"/></svg>
        </a>
        <a
          href="https://www.facebook.com/navsahyogfoundation/"
          target="_blank"
          rel="noopener"
          aria-label="Facebook"
          class="p-2 rounded-full bg-white/10 hover:bg-brand"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 22v-8h2.8l.4-3.2H13V8.7c0-.9.3-1.6 1.6-1.6H16V4.2A22 22 0 0 0 13.9 4c-2.3 0-3.9 1.4-3.9 4v2.8H7.2V14H10v8h3Z"/></svg>
        </a>
      </div>
    </div>

    <div>
      <h3 class="text-white font-semibold mb-4">Explore</h3>
      <ul class="space-y-2 text-sm text-white/80">
        <li><a href="/about/our-story/" class="hover:text-white">Our Story</a></li>
        <li><a href="/about/the-team/" class="hover:text-white">The Team</a></li>
        <li><a href="/program/intervention/" class="hover:text-white">Intervention</a></li>
        <li><a href="/program/presence/" class="hover:text-white">Presence</a></li>
        <li><a href="/impact/" class="hover:text-white">Impact</a></li>
        <li><a href="/downloads/" class="hover:text-white">Annual Reports</a></li>
        <li><a href="/donate/" class="hover:text-white">Donate</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-white font-semibold mb-4">Contact</h3>
      <address class="not-italic text-sm text-white/80 space-y-2">
        <p>B-104, Shobha Garnet,<br />Sarjapur Road, Iblur,<br />Bengaluru – 560102</p>
        <p>
          <a href="mailto:paritosh.segal@gmail.com" class="hover:text-white">paritosh.segal@gmail.com</a>
        </p>
        <p>
          <a href="tel:+919886624000" class="hover:text-white">+91 98866 24000</a>
        </p>
      </address>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-content py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/60">
      <p>© {year} NavSahyog Foundation. All rights reserved.</p>
      <p>Registered Indian not-for-profit · 80G &amp; 12A certified</p>
    </div>
  </div>
</footer>
