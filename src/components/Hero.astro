---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { splitAccentWord } from '../utils/accentWord';

export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  ctaPrimary?: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  accentWord?: string;
}

const { eyebrow, title, subtitle, image, imageAlt = '', ctaPrimary, ctaSecondary, accentWord } = Astro.props;

const split = splitAccentWord(title, accentWord);
---

<section class="bg-paper">
  <div class="container-content pt-16 md:pt-24 pb-16 md:pb-24 grid md:grid-cols-[1.3fr_1fr] gap-12 md:gap-16 items-end">
    <div>
      {eyebrow && (
        <div class="eyebrow">
          <span>{eyebrow}</span>
        </div>
      )}
      <h1 class="display text-fluid-hero2 leading-[0.95] tracking-display-tight text-ink m-0">
        {split ? (<>{split.before}<span class="display-italic text-accent">{split.word}</span>{split.after}</>) : title}
      </h1>
      {subtitle && (
        <p class="mt-8 text-lg md:text-21 leading-[1.45] text-ink-2 max-w-xl">{subtitle}</p>
      )}
      {(ctaPrimary || ctaSecondary) && (
        <div class="mt-9 flex flex-wrap gap-3">
          {ctaPrimary && (
            <a href={ctaPrimary.href} class="btn-primary px-8 py-4 text-base">{ctaPrimary.label}</a>
          )}
          {ctaSecondary && (
            <a href={ctaSecondary.href} class="btn-outline px-7 py-3.5 text-base">{ctaSecondary.label}</a>
          )}
        </div>
      )}
    </div>
    {image && (
      <div class="relative">
        <Image
          src={image}
          alt={imageAlt}
          class="w-full h-auto object-cover aspect-[3/4]"
          loading="eager"
        />
      </div>
    )}
  </div>
</section>
