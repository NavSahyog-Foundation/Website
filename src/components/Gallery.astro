---
import Img from './Img.astro';
import { media } from '../utils/media';

export interface Props {
  images: string[];
  alt?: string;
  columns?: 2 | 3 | 4;
}

const { images, alt = '', columns = 3 } = Astro.props;

const colClass = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 md:grid-cols-3',
  4: 'sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4',
}[columns];

const resolved = images
  .map((src, i) => ({ src, img: media(src), index: i }))
  .filter((entry): entry is { src: string; img: NonNullable<ReturnType<typeof media>>; index: number } => entry.img !== null);
---

<div class={`grid grid-cols-1 ${colClass} gap-3`}>
  {resolved.map(({ src, img, index }) => (
    <a href={img.src} class="block rounded-lg overflow-hidden bg-surface-soft group">
      <Img
        src={src}
        alt={alt ? `${alt} — ${index + 1}` : `Image ${index + 1}`}
        class="w-full h-48 sm:h-56 object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </a>
  ))}
</div>
