---
import { Image } from 'astro:assets';
import { wpImage } from '../utils/wp-images';

export interface Props {
  src: string;
  alt?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt = '', class: className = '', loading = 'lazy' } = Astro.props;
const img = wpImage(src);
---

{img && <Image src={img} alt={alt} class={className} loading={loading} />}
