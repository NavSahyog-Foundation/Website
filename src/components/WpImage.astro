---
import { url } from '../utils/url';

export interface Props {
  src: string;
  alt?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt = '', class: className = '', loading = 'lazy' } = Astro.props;

const normalized = src.startsWith('/')
  ? src.slice(1)
  : src.replace(/^https?:\/\/[^/]+\//, '');

const href = url(`/${normalized}`);
---

<img src={href} alt={alt} class={className} loading={loading} decoding="async" />
