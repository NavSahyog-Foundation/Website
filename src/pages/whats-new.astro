---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Img from '../components/Img.astro';

const updates = [
  {
    title: 'A Detailed view of our Programme — Pragathi TV',
    image: '2023/10/Screenshot-902.png',
    video: 'https://youtu.be/EfpTWtge4uc?si=uqXUIfp2-hh1AbXw',
  },
  {
    title: 'Gandhi Jayanti Celebration in 300 Villages, 2023',
    image: '2023/10/Gandhi-Jayanti-0223-1536x864.jpg',
    video: 'https://youtu.be/1m8t5xQU8eQ?si=jhlg8KlHNHkCBYAD',
  },
  {
    title: 'Vanya Samriddhi · Programme Launch',
    image: '2023/10/Vanya-Samriddhi-ENG-2023-1536x864.jpg',
    video: 'https://youtu.be/QqhHuOMaieQ?si=rezv0zkM2ETSeWG0',
  },
];
---

<Layout title="What's New" description="Latest videos and updates from NavSahyog Foundation's programmes and villages.">
  <PageHeader
    eyebrow="Updates"
    title="What's new."
    accentWord="new"
    subtitle="Latest videos from our programmes."
  />

  <div class="container-content py-12 grid md:grid-cols-2 gap-6">
    {updates.map((u) => (
      <a href={u.video} target="_blank" rel="noopener" class="group block bg-paper border border-line hover:border-accent transition-colors">
        <div class="relative aspect-video overflow-hidden bg-paper-alt">
          <Img src={u.image} alt={u.title} class="w-full h-full object-cover group-hover:opacity-95 transition" />
          <div class="absolute inset-0 flex items-center justify-center bg-black/25">
            <div class="w-16 h-16 rounded-full bg-paper flex items-center justify-center">
              <svg class="w-6 h-6 text-accent ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
        </div>
        <div class="p-6">
          <h2 class="display text-lg md:text-xl tracking-display-tight font-medium text-ink m-0 group-hover:text-accent">{u.title}</h2>
          <p class="mt-3 text-sm font-semibold text-accent">Watch on YouTube →</p>
        </div>
      </a>
    ))}
  </div>
</Layout>
