---
import Layout from '../layouts/Layout.astro';
import { url } from '../utils/url';
---

<Layout title="Page Not Found">
  <section class="container-content py-24 text-center">
    <p class="text-brand font-semibold uppercase tracking-wide text-sm mb-3">404</p>
    <h1 class="text-4xl md:text-5xl font-bold mb-4">Page Not Found</h1>
    <p class="text-lg text-ink/80 max-w-xl mx-auto mb-8">
      The page you're looking for has moved, or never existed. Try one of these instead.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href={url('/')} class="btn-primary">Home</a>
      <a href={url('/about/our-story/')} class="btn-outline">Our Story</a>
      <a href={url('/donate/')} class="btn-outline">Donate</a>
    </div>
  </section>
</Layout>
