  { title: 'Tournament day — 4 Nov 2023 (H)', image: '2023/11/WhatsApp-Image-2023-11-04-at-6.16.14-PM.jpeg', source: 'Regional press' },
  { title: 'Tournament day — 4 Nov 2023 (I)', image: '2023/11/WhatsApp-Image-2023-11-04-at-6.16.14-PM-1.jpeg', source: 'Regional press' },
  { title: 'Tournament day — 4 Nov 2023 (J)', image: '2023/11/WhatsApp-Image-2023-11-04-at-6.19.03-PM-1.jpeg', source: 'Regional press' },
  { title: 'Tournament day — 4 Nov 2023 (K)', image: '2023/11/WhatsApp-Image-2023-11-04-at-8.48.55-PM.jpeg', source: 'Regional press' },
