  { title: 'Tournament day — 4 Nov 2023 (B)', image: '2023/11/WhatsApp-Image-2023-11-04-at-6.16.15-PM.jpeg', source: 'Regional press' },
  { title: 'Tournament day — 4 Nov 2023 (C)', image: '2023/11/WhatsApp-Image-2023-11-04-at-8.18.13-PM.jpeg', source: 'Regional press' },
  { title: 'Report clipping', image: '2023/11/Untitled-2.png', source: 'Regional press' },
  { title: 'Tournament day — 4 Nov 2023 (D)', image: '2023/11/WhatsApp-Image-2023-11-04-at-6.20.17-PM.jpeg', source: 'Regional press' },
  { title: 'Tournament day — 4 Nov 2023 (E)', image: '2023/11/WhatsApp-Image-2023-11-04-at-8.27.57-PM.jpeg', source: 'Regional press' },
