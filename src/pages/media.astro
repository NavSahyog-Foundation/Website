  { title: 'Tournament coverage', image: '2024/09/Sanjevani-1.jpeg', source: 'Sanjevani' },
  { title: 'Tournament coverage', image: '2024/09/Udayakala-1.jpeg', source: 'Udayakala' },
  { title: 'Field report — July 2024', image: '2024/09/WhatsApp-Image-2024-07-11-at-11.45.41-e1729149195701.jpeg', source: 'Regional press' },
  { title: 'Programme coverage — April 2023', image: '2023/07/WhatsApp-Image-2023-04-03-at-11.28.26-AM.jpeg', source: 'Regional press' },
  { title: 'Programme coverage — April 2023', image: '2023/07/WhatsApp-Image-2023-04-03-at-11.28.23-AM.jpeg', source: 'Regional press' },
  { title: 'Programme coverage — April 2023', image: '2023/07/WhatsApp-Image-2023-04-03-at-11.28.27-AM.jpeg', source: 'Regional press' },
