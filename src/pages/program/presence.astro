---
import Layout from '../../layouts/Layout.astro';
import Img from '../../components/Img.astro';
import { clustersByRegion } from '../../data/villages';
import { url } from '../../utils/url';
---

<Layout title="Presence" description="NavSahyog Foundation is present in 300 villages across Karnataka, Tamil Nadu and Nagaland.">

  <!-- Hero -->
  <section class="bg-paper">
    <div class="container-content pt-20 md:pt-28 pb-12">
      <div class="eyebrow"><span>Our Programme</span></div>
      <h1 class="display text-fluid-6xl leading-[0.95] tracking-display-tight m-0 max-w-5xl">
        300 villages. <span class="display-italic text-accent">Three states.</span>
      </h1>
      <p class="mt-7 text-lg md:text-xl leading-[1.5] text-ink-2 max-w-2xl">
        We choose remote villages with strong local champions. Every cluster covers villages within a one-hour radius — which keeps facilitator travel low and field presence high.
      </p>
    </div>
  </section>

  <!-- Map + clusters -->
  <section class="section-y-xs">
    <div class="container-content grid lg:grid-cols-[2fr_3fr] gap-12 lg:gap-16 items-start">
      <div class="lg:sticky lg:top-28">
        <Img
          src="2023/09/NSF-Presence-v-1-768x903.png"
          alt="NavSahyog Foundation presence map"
          class="w-full h-auto bg-paper-alt"
          loading="eager"
        />
        <p class="label-mono mt-4 tracking-label-08 text-ink-3">
          Click cluster names below to see the villages.
        </p>
      </div>

      <div class="space-y-14">
        {Object.entries(clustersByRegion).map(([region, clusters]) => (
          <section>
            <div class="flex items-end justify-between gap-6 mb-6 pb-3 border-b border-ink">
              <div>
                <div class="eyebrow m-0"><span>{region}</span></div>
              </div>
              <div class="label-mono tracking-label-12 text-ink-3">{clusters.length} {clusters.length === 1 ? 'cluster' : 'clusters'}</div>
            </div>
            <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-0 m-0 p-0 list-none">
              {clusters.map((c) => (
                <li class="border-t border-line">
                  {c.hasPage ? (
                    <a
                      href={url(`/program/villages/${c.slug}/`)}
                      class="block py-4 hover:text-accent transition-colors group"
                    >
                      <div class="flex items-baseline justify-between gap-3">
                        <div class="display text-xl tracking-display-tight">{c.name}</div>
                        <span class="text-accent text-sm" aria-hidden="true">→</span>
                      </div>
                      {c.district && <div class="text-[13px] text-ink-3 mt-1">{c.district}</div>}
                    </a>
                  ) : (
                    <div class="py-4">
                      <div class="display text-xl tracking-display-tight text-ink-2">{c.name}</div>
                      {c.district && <div class="text-[13px] text-ink-3 mt-1">{c.district}</div>}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>
</Layout>
