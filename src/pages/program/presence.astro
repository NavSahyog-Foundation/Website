---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import WpImage from '../../components/WpImage.astro';
import { clustersByRegion } from '../../data/villages';
import { url } from '../../utils/url';
---

<Layout title="Presence" description="NavSahyog Foundation is present in 300 villages across Karnataka, Tamil Nadu and Nagaland.">
  <PageHeader
    eyebrow="Our Programme"
    title="Presence"
    subtitle="We are currently present in 300 villages across Karnataka, Tamil Nadu and Nagaland."
  />

  <div class="container-content py-12 grid lg:grid-cols-5 gap-10">
    <div class="lg:col-span-2">
      <WpImage
        src="wp-content/uploads/2023/09/NSF-Presence-v-1-768x903.png"
        alt="NavSahyog Foundation presence map"
        class="rounded-xl w-full h-auto shadow-sm bg-white"
        loading="eager"
      />
      <p class="mt-4 text-sm text-ink/70 italic">
        Click on the names of locations below to see all the villages under each cluster.
      </p>
    </div>

    <div class="lg:col-span-3 space-y-10">
      {Object.entries(clustersByRegion).map(([region, clusters]) => (
        <section>
          <h2 class="text-2xl font-bold mb-2">In {region} we are present in</h2>
          <ul class="grid sm:grid-cols-2 gap-2">
            {clusters.map((c) => (
              <li>
                {c.hasPage ? (
                  <a
                    href={url(`/program/villages/${c.slug}/`)}
                    class="block rounded-lg border border-slate-200 p-4 bg-white hover:border-brand hover:bg-brand-50 transition"
                  >
                    <p class="font-semibold text-brand">{c.name}</p>
                    {c.district && <p class="text-sm text-ink/70">{c.district}</p>}
                  </a>
                ) : (
                  <div class="block rounded-lg border border-slate-200 p-4 bg-surface-soft">
                    <p class="font-semibold text-ink">{c.name}</p>
                    {c.district && <p class="text-sm text-ink/70">{c.district}</p>}
                  </div>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Layout>
