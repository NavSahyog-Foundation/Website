---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';

const projects = [
  {
    name: 'Vanya Samriddhi',
    tagline: 'Food forests on barren land.',
    body: 'Working with farmers, we turn barren one-acre plots into food forests — mixed-species plantings that restore the soil, provide food year-round, and create a durable new source of livelihood. This significantly enhances farmers\' productivity, makes them more resilient to climate change, and opens livelihood opportunities for rural youth.',
  },
  {
    name: 'Jal Vriddhi',
    tagline: 'Recharging the groundwater table.',
    body: 'A village-led programme to recharge groundwater through farm ponds and bunds co-created with farmers. We teach children the value of water and build the infrastructure to preserve it. Currently running in Haliyal, Karnataka.',
  },
  {
    name: 'Yuva Samriddhi',
    tagline: 'Self-employment for rural youth.',
    body: 'In collaboration with CBD-RSETI in Haliyal, Karnataka, we train rural youth in self-employment — turning the entrepreneurship mindset our children grow up with into working businesses.',
  },
  {
    name: 'Dhan Kaushal',
    tagline: 'Financial literacy for children and youth.',
    body: 'A financial-literacy curriculum delivered alongside the core programme — savings, budgeting, and the basics of running a small enterprise. Rolled out with schools in Belagavi in partnership with MASS.',
  },
  {
    name: 'Prakriti Prem',
    tagline: 'A fruit sapling for every child.',
    body: 'Every child in a NavSahyog village is given a fruit sapling to nurture and grow into a fruit tree. Clusters of villages compete to see whose trees thrive best — combining environmental learning, responsibility, and community pride.',
  },
];
---

<Layout title="Projects" description="NavSahyog Foundation's projects that extend the core life-skills programme into livelihood, finance, and environment.">
  <PageHeader
    eyebrow="Our Programme"
    title="Projects"
    subtitle="Extensions of our core life-skills programme — each building a concrete link to livelihood, finance, or environment."
  />

  <div class="container-content py-16 grid md:grid-cols-2 gap-6">
    {projects.map((p) => (
      <article class="rounded-xl border border-slate-200 p-8 bg-white shadow-sm">
        <h2 class="text-xl md:text-2xl font-bold text-brand">{p.name}</h2>
        <p class="text-ink/80 italic mt-1 mb-4">{p.tagline}</p>
        <p class="text-ink/90 leading-relaxed">{p.body}</p>
      </article>
    ))}
  </div>
</Layout>
