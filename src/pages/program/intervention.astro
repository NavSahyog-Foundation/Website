import PageHeader from '../../components/PageHeader.astro';
import Gallery from '../../components/Gallery.astro';
import WpImage from '../../components/WpImage.astro';

const gallery = [
  { src: 'wp-content/uploads/2021/07/fghf.jpg', caption: 'Tug-of-war' },
  { src: 'wp-content/uploads/2021/11/WhatsApp-Image-2021-09-25-at-10.52.04.jpg', caption: 'Long Jump' },
  { src: 'wp-content/uploads/2021/11/WhatsApp-Image-2021-09-25-at-10.51.59-1.jpg', caption: 'High Jump — caught in action' },
  { src: 'wp-content/uploads/2021/07/2.jpg', caption: 'Playing board games with family members' },
  { src: 'wp-content/uploads/2021/07/ifjbknb.jpg', caption: 'Children doing Yoga' },
  { src: 'wp-content/uploads/2021/11/IMG-20210308-WA0095.jpg', caption: 'Children from Haliyal performing Yoga' },
  { src: 'wp-content/uploads/2021/11/IMG-20201025-WA0158.jpg', caption: 'Children performing Yoga' },
  { src: 'wp-content/uploads/2021/07/4-1.jpg', caption: 'Quarterly competition at Haliyal' },
  { src: 'wp-content/uploads/2021/11/IMG-20210211-WA0064.jpg', caption: 'Children enjoying a game of Tic-Tac-Toe' },
  { src: 'wp-content/uploads/2021/07/3-1.jpg', caption: 'Experiential Learning — child planting a sapling' },
  { src: 'wp-content/uploads/2021/07/IMG-20210422-WA0061.jpg', caption: 'Experiential learning through Project BoN' },
  { src: 'wp-content/uploads/2021/11/IMG-20200812-WA0034.jpg', caption: 'Project BoN — fence making' },
  { src: 'wp-content/uploads/2021/11/WhatsApp-Image-2021-07-09-at-18.06.37.jpg', caption: 'Project BoN evaluation — Haliyal' },
  { src: 'wp-content/uploads/2021/07/7-1.jpg', caption: 'Child with her grown papaya tree' },
  { src: 'wp-content/uploads/2021/11/IMG-20210815-WA0399.jpg', caption: 'Children planting a sapling on 15 August — Green Drive' },
  { src: 'wp-content/uploads/2021/11/IMG-20210908-WA0010.jpg', caption: 'BoN Phase 2 — distribution of vegetable seeds' },
  { src: 'wp-content/uploads/2021/11/IMG-20210411-WA0042-2-1.jpg', caption: 'Creative artwork by our children' },
  { src: 'wp-content/uploads/2021/11/IMG-20210223-WA0035.jpg', caption: 'Artwork by our children' },
