---
import Layout from '../../layouts/Layout.astro';
import Img from '../../components/Img.astro';

const gallery = [
  { src: '2021/07/fghf.jpg', caption: 'Tug-of-war' },
  { src: '2021/11/WhatsApp-Image-2021-09-25-at-10.52.04.jpg', caption: 'Long Jump' },
  { src: '2021/11/WhatsApp-Image-2021-09-25-at-10.51.59-1.jpg', caption: 'High Jump — caught in action' },
  { src: '2021/07/2.jpg', caption: 'Playing board games with family' },
  { src: '2021/07/ifjbknb.jpg', caption: 'Children doing Yoga' },
  { src: '2021/11/IMG-20210308-WA0095.jpg', caption: 'Yoga · Haliyal' },
  { src: '2021/11/IMG-20201025-WA0158.jpg', caption: 'Children performing Yoga' },
  { src: '2021/07/4-1.jpg', caption: 'Quarterly competition · Haliyal' },
  { src: '2021/11/IMG-20210211-WA0064.jpg', caption: 'Tic-Tac-Toe' },
  { src: '2021/07/3-1.jpg', caption: 'Experiential learning · planting a sapling' },
  { src: '2021/07/IMG-20210422-WA0061.jpg', caption: 'Project BoN — experiential learning' },
  { src: '2021/11/IMG-20200812-WA0034.jpg', caption: 'Project BoN — fence making' },
  { src: '2021/11/WhatsApp-Image-2021-07-09-at-18.06.37.jpg', caption: 'Project BoN evaluation · Haliyal' },
  { src: '2021/07/7-1.jpg', caption: 'Child with her grown papaya tree' },
  { src: '2021/11/IMG-20210815-WA0399.jpg', caption: 'Sapling planting · Green Drive 15 Aug' },
  { src: '2021/11/IMG-20210908-WA0010.jpg', caption: 'BoN Phase 2 · vegetable seeds' },
  { src: '2021/11/IMG-20210411-WA0042-2-1.jpg', caption: 'Creative artwork by our children' },
  { src: '2021/11/IMG-20210223-WA0035.jpg', caption: 'Artwork by our children' },
  { src: '2021/07/hfhdfd.jpg', caption: 'Thumb painting' },
  { src: '2021/07/hggn.jpg', caption: 'Leaf art' },
  { src: '2021/07/fhifd.jpg', caption: 'Paper cutting' },
];

const structure = [
  ['Village Coordinator', 'Conducts the programme in every village.'],
  ['Area Facilitator', 'Mobile on a scooter, supporting a cluster of 18–20 villages.'],
  ['Mon–Sat', 'Sports, Yoga and Meditation after school.'],
  ['Sunday', 'Creative activities (thumb painting, clay modelling) and storytelling.'],
  ['Quarterly + Annual', 'Competitions in every village for children and the community.'],
  ['Star of the Month', 'One girl and one boy per village, based on improvement in life-skill and non-life-skill parameters.'],
];
---

<Layout title="Intervention" description="NavSahyog Foundation's daily intervention: sports, storytelling, creative activities, experiential learning and emotional intelligence sessions for village children aged 5–14.">

  <!-- Hero -->
  <section class="bg-paper">
    <div class="container-content pt-20 md:pt-28 pb-12 grid md:grid-cols-[1.2fr_1fr] gap-12 md:gap-16 items-end">
      <div>
        <div class="eyebrow"><span>Our Programme</span></div>
        <h1 class="display text-[clamp(2.75rem,6vw,5.5rem)] leading-[0.95] tracking-display-tight m-0">
          Life skills and creativity, <span class="display-italic text-accent">every day</span>, in every village.
        </h1>
        <p class="mt-7 text-lg md:text-xl leading-[1.5] text-ink-2 max-w-xl">
          We develop life skills and creativity in village children at their most impressionable age (5–14) through sport, storytelling, creative activity, experiential learning and emotional intelligence sessions.
        </p>
      </div>
      <Img src="2022/05/IMG_20201205_120751-1-930x620.jpg" alt="Life skills activities" class="w-full aspect-[4/5] object-cover bg-paper-alt" />
    </div>
  </section>

  <!-- The activities -->
  <section class="py-20 md:py-28">
    <div class="container-content grid md:grid-cols-[1fr_2fr] gap-12 md:gap-20 items-start">
      <div class="md:sticky md:top-28">
        <div class="eyebrow"><span>Activities</span></div>
        <h2 class="display text-[clamp(1.75rem,3vw,2.5rem)] leading-[1.05] tracking-display-tight m-0">
          Traditional sport. Indigenous games. The earth itself.
        </h2>
      </div>
      <article>
        <div class="py-7 border-t border-ink">
          <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-accent mb-3">01 · Traditional Indian sport</div>
          <p class="m-0 text-[17px] leading-[1.6] text-ink-2">Yoga, Kho-Kho, Kabaddi, long jump, high jump and running races — sport that builds confidence, teaming and resilience.</p>
        </div>
        <div class="py-7 border-t border-line">
          <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-accent mb-3">02 · Board games</div>
          <p class="m-0 text-[17px] leading-[1.6] text-ink-2">Strategy and mental skills — Aadu Puli (Goat and Tiger), Thaayam, Tic-Tac-Toe and more.</p>
        </div>
        <div class="py-7 border-t border-line">
          <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-accent mb-3">03 · Project Nature &amp; Nutrition</div>
          <p class="m-0 text-[17px] leading-[1.6] text-ink-2">Experiential learning rooted in the earth — each child plants, grows and tends a sapling provided to them.</p>
        </div>
        <div class="py-7 border-t border-line">
          <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-accent mb-3">04 · Value of Water</div>
          <p class="m-0 text-[17px] leading-[1.6] text-ink-2">Children co-create farm ponds and bunds with farmers — addressing water-table depletion while learning the value of water.</p>
        </div>
        <div class="border-t border-line"></div>
      </article>
    </div>
  </section>

  <!-- Structure & Process -->
  <section class="bg-paper-alt border-y border-line py-20 md:py-28">
    <div class="container-content grid md:grid-cols-2 gap-16 items-center">
      <Img src="2022/05/Untitled-design-1024x1024.png" alt="Structure and process diagram" class="w-full aspect-square object-contain bg-paper p-8 border border-line" />
      <div>
        <div class="eyebrow"><span>Structure &amp; Process</span></div>
        <h2 class="display text-[clamp(2rem,3.5vw,3rem)] leading-[1.05] tracking-display-tight m-0 mb-9">
          A village coordinator, a cluster facilitator, a daily cadence.
        </h2>
        <div class="space-y-0">
          {structure.map(([k, v], i) => (
            <div class:list={['sm:grid sm:grid-cols-[160px_1fr] md:grid-cols-[180px_1fr] sm:gap-6 py-5', i === 0 ? 'border-t border-ink' : 'border-t border-line']}>
              <div class="font-mono text-[12px] uppercase tracking-[0.12em] text-accent mb-2 sm:mb-0">{k}</div>
              <p class="m-0 text-[15px] leading-relaxed text-ink-2">{v}</p>
            </div>
          ))}
          <div class="border-t border-line"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- From the field -->
  <section class="py-20 md:py-28">
    <div class="container-content">
      <div class="eyebrow"><span>From the field</span></div>
      <h2 class="display text-[clamp(2rem,3.5vw,3rem)] leading-[1.05] tracking-display-tight m-0 mb-12 max-w-2xl">Daily activities, in motion.</h2>
      <div class="max-w-3xl">
        <ul class="space-y-5 m-0 p-0 list-none">
          <li class="flex gap-4 items-start">
            <span class="mt-1.5 shrink-0 w-2 h-2 rounded-full bg-accent"></span>
            <p class="text-[18px] leading-[1.6] text-ink-2 m-0">Every day after school, children in our villages gather — not for more textbooks, but for movement, play, and expression. Sport, yoga, storytelling, and games that most village children rarely get to experience.</p>
          </li>
          <li class="flex gap-4 items-start">
            <span class="mt-1.5 shrink-0 w-2 h-2 rounded-full bg-accent"></span>
            <p class="text-[18px] leading-[1.6] text-ink-2 m-0">Through Yoga, Kho-Kho, Kabaddi, and track events, children compete and grow on a level playing field — the same track, the same rules, regardless of caste, income, or family background. Here, effort is what counts.</p>
          </li>
          <li class="flex gap-4 items-start">
            <span class="mt-1.5 shrink-0 w-2 h-2 rounded-full bg-accent"></span>
            <p class="text-[18px] leading-[1.6] text-ink-2 m-0">Board games like Aadu Puli and Thaayam bring strategy, patience, and laughter — quietly building the kind of thinking that no classroom can rush, and the kind of joy that no textbook can deliver.</p>
          </li>
          <li class="flex gap-4 items-start">
            <span class="mt-1.5 shrink-0 w-2 h-2 rounded-full bg-accent"></span>
            <p class="text-[18px] leading-[1.6] text-ink-2 m-0">Each child is given a sapling and asked to nurture it — from a tender seedling into a living tree. What begins as a lesson in nature quietly becomes something deeper: proof that with care and commitment, small things grow into something lasting.</p>
          </li>
          <li class="flex gap-4 items-start">
            <span class="mt-1.5 shrink-0 w-2 h-2 rounded-full bg-accent"></span>
            <p class="text-[18px] leading-[1.6] text-ink-2 m-0">Village coordinators show up Monday through Saturday, every week, all year. For many children, this consistency becomes the most reliable relationship they know — and a quiet reminder that they are worth showing up for.</p>
          </li>
          <li class="flex gap-4 items-start">
            <span class="mt-1.5 shrink-0 w-2 h-2 rounded-full bg-accent"></span>
            <p class="text-[18px] leading-[1.6] text-ink-2 m-0">Cluster competitions bring villages together, giving children the chance to represent their community and discover — perhaps for the first time — what it feels like to be seen, celebrated, and cheered on for their own effort.</p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Photo gallery -->
  <section class="pb-24 md:pb-32">
    <div class="container-content">
      <div class="flex items-end justify-between gap-6 mb-8 pb-4 border-b border-ink">
        <div class="eyebrow m-0"><span>Photo gallery</span></div>
        <div class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-3">{gallery.length} images</div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 md:gap-4">
        {gallery.map((g) => (
          <figure class="m-0">
            <Img src={g.src} alt={g.caption} class="w-full aspect-[4/3] object-cover bg-paper-alt" />
            <figcaption class="font-mono text-[10px] uppercase tracking-[0.06em] text-ink-3 mt-2">{g.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</Layout>
