---
import Layout from '../../../layouts/Layout.astro';
import Gallery from '../../../components/Gallery.astro';
import Img from '../../../components/Img.astro';
import { url } from '../../../utils/url';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('villages');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'villages'>;
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
---

<Layout title={d.title} description={d.summary}>

  <!-- Hero -->
  <section class="bg-paper">
    <div class="container-content pt-20 md:pt-28 pb-10">
      <div class="eyebrow"><span>{d.region}{d.cluster ? ' · ' + d.cluster : ''}</span></div>
      <h1 class="display text-fluid-3xl3 leading-[0.98] tracking-display-tight m-0 max-w-4xl">{d.title}</h1>
      {d.summary && <p class="mt-7 text-lg md:text-xl leading-[1.5] text-ink-2 max-w-3xl">{d.summary}</p>}
    </div>
  </section>

  {d.heroImage && (
    <section class="pb-12">
      <div class="container-content">
        <Img src={d.heroImage} alt={d.title} class="w-full aspect-[16/9] object-cover bg-paper-alt" loading="eager" />
      </div>
    </section>
  )}

  <article class="py-12">
    <div class="container-content max-w-3xl prose-content">
      <Content />
    </div>
  </article>

  {d.villageNames && d.villageNames.length > 0 && (
    <section class="py-12 border-t border-line">
      <div class="container-content">
        <div class="flex items-end justify-between gap-6 mb-8 pb-4 border-b border-ink">
          <div class="eyebrow m-0"><span>Villages in this cluster</span></div>
          <div class="label-mono tracking-label-12 text-ink-3">{d.villageNames.length} villages</div>
        </div>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-0 m-0 p-0 list-none">
          {d.villageNames.map((v) => (
            <li class="display text-lg tracking-display-tight text-ink py-3 border-b border-line">{v}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {d.gallery.length > 0 && (
    <section class="py-12 border-t border-line">
      <div class="container-content">
        <div class="eyebrow"><span>Photo gallery</span></div>
        <Gallery images={d.gallery} alt={d.title} columns={3} />
      </div>
    </section>
  )}

  <section class="py-12">
    <div class="container-content">
      <a href={url('/program/presence/')} class="btn-outline px-6 py-3">← All villages</a>
    </div>
  </section>
</Layout>
