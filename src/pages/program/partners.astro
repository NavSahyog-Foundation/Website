---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { partnerCategories } from '../../data/partners';
---

<Layout title="Partners" description="The funding and programme partners who make NavSahyog Foundation's work possible.">
  <PageHeader
    eyebrow="Our Programme"
    title="Our Partners"
    subtitle="We are grateful to every organisation that has stood alongside us."
  />

  <div class="container-content py-16 space-y-12">
    {partnerCategories.map((cat) => (
      <section>
        <h2 class="text-2xl font-bold mb-5">{cat.heading}</h2>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {cat.partners.map((p) => (
            <li class="rounded-xl border border-slate-200 p-5 bg-white">
              {p.url ? (
                <a href={p.url} target="_blank" rel="noopener" class="font-semibold text-brand hover:underline">
                  {p.name}
                </a>
              ) : (
                <p class="font-semibold text-ink">{p.name}</p>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section class="rounded-xl bg-brand-50 border border-brand-100 p-8">
      <h2 class="text-2xl font-bold mb-2">Become a partner</h2>
      <p class="text-ink/80 mb-6 max-w-2xl">
        Whether you're a CSR team, a family foundation, or an individual donor — we'd love to hear
        from you.
      </p>
      <a href="/contact/" class="btn-primary">Get in touch</a>
    </section>
  </div>
</Layout>
