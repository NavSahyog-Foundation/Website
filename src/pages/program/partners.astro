---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Img from '../../components/Img.astro';
import { partnerLogos } from '../../data/partners';
import { url } from '../../utils/url';
---

<Layout title="Partners" description="The partners who make NavSahyog Foundation's work possible.">
  <PageHeader
    eyebrow="Our Programme"
    title="Partners"
    subtitle="We are grateful to every organisation that has stood alongside us."
  />

  <div class="container-content py-16">
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 md:gap-6">
      {partnerLogos.map((p) => (
        <div class="bg-white border border-slate-200 rounded-lg p-4 flex items-center justify-center aspect-video">
          {p.url ? (
            <a href={p.url} target="_blank" rel="noopener" class="block w-full h-full">
              <Img src={p.logo} alt={p.name} class="w-full h-full object-contain" />
            </a>
          ) : (
            <Img src={p.logo} alt={p.name} class="w-full h-full object-contain" />
          )}
        </div>
      ))}
    </div>

    <section class="mt-16 rounded-xl bg-brand-50 border border-brand-100 p-8">
      <h2 class="text-2xl font-bold mb-2">Become a partner</h2>
      <p class="text-ink/80 mb-6 max-w-2xl">
        Whether you're a CSR team, a family foundation, or an individual donor — we'd love to hear
        from you.
      </p>
      <a href={url('/contact/')} class="btn-primary">Get in touch</a>
    </section>
  </div>
</Layout>
