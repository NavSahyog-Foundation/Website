---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { donorsByYear } from '../../data/donors';
import { url } from '../../utils/url';
---

<Layout title="Individual Donors" description="Our esteemed individual donors — every year, a list of people whose generosity makes our work possible.">
  <PageHeader
    eyebrow="Our Programme"
    title="Individual Donors"
    subtitle="We are deeply grateful to the individuals who fund our work, year after year."
  />

  <div class="container-content py-16 space-y-14">
    {donorsByYear.map((y) => (
      <section>
        <h2 class="text-2xl font-bold mb-6">{y.heading}</h2>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-2">
          {y.donors.map((d) => (
            <li class="text-ink/90 border-b border-slate-100 py-1.5 flex items-start gap-2">
              <span class="text-brand/60 shrink-0">—</span>
              <span>{d}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section class="rounded-xl bg-brand text-white p-8">
      <h2 class="text-2xl font-bold mb-2">Join this list</h2>
      <p class="text-white/90 mb-6 max-w-2xl">
        Your contribution — large or small, one-off or monthly — directly funds a child's daily
        engagement in our programme.
      </p>
      <a href={url('/donate/')} class="btn bg-white text-brand hover:bg-white/90">Donate</a>
    </section>
  </div>
</Layout>
