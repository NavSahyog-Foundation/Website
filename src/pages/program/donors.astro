---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Img from '../../components/Img.astro';
import { donorsByYear } from '../../data/donors';
import { url } from '../../utils/url';

const corporateLogos = [
  { name: 'Infosys Foundation', logo: '2023/07/Infosy-foundation_Logo_Blue.jpg' },
  { name: 'TVS', logo: '2023/07/Tvs-logo.jpg' },
  { name: 'Corporate Donor', logo: '2023/07/download.png' },
  { name: 'Corporate Donor', logo: '2023/07/download-1.png' },
  { name: 'Corporate Donor', logo: '2021/07/download-1-1.jpg' },
];

const acknowledgements = [
  '2026/04/Screenshot-2026-04-06-080949.png',
  '2026/04/Screenshot-2026-04-06-081126-e1775443438396.png',
  '2026/04/Screenshot-2026-04-06-081300.png',
  '2026/04/Screenshot-2026-04-06-082942.png',
  '2026/04/Screenshot-2026-04-06-083510.png',
  '2026/04/Screenshot-2026-04-06-084027.png',
  '2026/04/Screenshot-2026-04-06-084123.png',
  '2026/04/Screenshot-2026-04-06-084353.png',
  '2026/04/Screenshot-2026-04-06-084529.png',
  '2026/04/Screenshot-2026-04-06-084740.png',
  '2026/04/Screenshot-2026-04-06-084833.png',
  '2026/04/Screenshot-2026-04-06-084947.png',
];
---

<Layout title="Individual Donors" description="Our esteemed individual donors and corporate partners — the generosity behind our daily work.">
  <PageHeader
    eyebrow="Our Programme"
    title="The donors who fund this work, year after year."
    accentWord="year after year"
    subtitle="We are deeply grateful to the individuals and organisations who keep the daily programme running."
  />

  <div class="container-content py-12 md:py-16 space-y-20">
    <!-- Corporate -->
    <section>
      <div class="flex items-end justify-between gap-6 mb-8 pb-4 border-b border-ink">
        <div class="eyebrow m-0"><span>Corporate donors &amp; partners</span></div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-px bg-line border border-line">
        {corporateLogos.map((c) => (
          <div class="bg-paper aspect-[4/3] flex items-center justify-center p-6">
            <Img src={c.logo} alt={c.name} class="max-w-full max-h-full object-contain" />
          </div>
        ))}
      </div>
    </section>

    {donorsByYear.map((y) => (
      <section>
        <div class="flex items-end justify-between gap-6 mb-8 pb-4 border-b border-ink">
          <div class="eyebrow m-0"><span>{y.heading}</span></div>
          <div class="label-mono tracking-label-12 text-ink-3">{y.donors.length} donors</div>
        </div>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-0 m-0 p-0 list-none">
          {y.donors.map((d) => (
            <li class="text-[15px] text-ink py-2.5 border-b border-line">{d}</li>
          ))}
        </ul>
      </section>
    ))}

    <section>
      <div class="flex items-end justify-between gap-6 mb-8 pb-4 border-b border-ink">
        <div class="eyebrow m-0"><span>Donor acknowledgements</span></div>
      </div>
      <p class="text-base text-ink-2 max-w-3xl mb-10 leading-relaxed">Snapshots shared on our social channels and annual reports.</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        {acknowledgements.map((src, i) => (
          <Img src={src} alt={`Donor acknowledgement ${i + 1}`} class="w-full aspect-[4/3] object-cover bg-paper-alt" />
        ))}
      </div>
    </section>

    <section class="bg-ink text-paper p-10 md:p-14 grid md:grid-cols-[2fr_1fr] gap-10 items-center">
      <div>
        <div class="inline-flex items-center gap-2.5 mb-4">
          <span class="block w-7 h-px bg-accent"></span>
          <span class="label-mono tracking-label-18 text-accent font-medium">Join this list</span>
        </div>
        <h2 class="display text-fluid-xs leading-[1.05] tracking-display-tight m-0 mb-3 text-paper">
          Every gift becomes a day in a child's life.
        </h2>
        <p class="text-[15px] text-paper/75 leading-relaxed m-0 max-w-xl">
          Your contribution — large or small, one-off or monthly — directly funds a child's daily engagement in our programme.
        </p>
      </div>
      <div>
        <a href={url('/donate/')} class="inline-flex items-center gap-2 bg-accent text-white px-7 py-3.5 rounded-full text-base font-semibold hover:bg-accent-deep">Donate <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </div>
</Layout>
