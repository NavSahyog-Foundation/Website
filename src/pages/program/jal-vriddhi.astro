---
import Layout from '../../layouts/Layout.astro';
import ProgramDashboard from '../../components/ProgramDashboard.astro';
import jalVriddhiDashboard from '../../data/program-dashboards/jal-vriddhi.json';

const statuses = [
  { key: 'active',   label: 'Active',   color: '#059669' },
  { key: 'inactive', label: 'Inactive', color: '#64748b' },
];
---

<Layout
  title="Jal Vriddhi"
  description="Jal Vriddhi is NavSahyog Foundation's village-led water-stewardship programme — recharging groundwater through farm ponds and bunds co-created with farmers."
>

  <!-- Hero -->
  <section class="bg-paper">
    <div class="container-content pt-20 md:pt-28 pb-12">
      <div class="eyebrow"><span>Our Programme</span></div>
      <h1 class="display text-[clamp(3rem,6.5vw,6rem)] leading-[0.95] tracking-display-tight m-0 max-w-5xl">
        Recharging the groundwater table, <span class="display-italic text-accent">one pond</span> at a time.
      </h1>
      <p class="mt-7 text-lg md:text-xl leading-[1.5] text-ink-2 max-w-2xl">
        Jal Vriddhi is a village-led programme to recharge groundwater through farm ponds and bunds, co-created with farmers. We teach children the value of water and build the infrastructure to preserve it.
      </p>
    </div>
  </section>

  <!-- Headline numbers + recognition -->
  <section class="border-y border-line py-14">
    <div class="container-content grid md:grid-cols-3 gap-10">
      <div>
        <div class="display text-[clamp(3rem,6vw,5rem)] leading-[0.95] tracking-[-0.045em] text-ink">280<span class="text-accent">+</span></div>
        <p class="mt-4 text-[15px] text-ink-2 max-w-[16rem] leading-snug">Farm ponds co-created with farmers across partner villages.</p>
      </div>
      <div>
        <div class="display text-[clamp(3rem,6vw,5rem)] leading-[0.95] tracking-[-0.045em] text-ink">200M L<span class="text-accent">/yr</span></div>
        <p class="mt-4 text-[15px] text-ink-2 max-w-[16rem] leading-snug">Rainwater percolated annually back into the local water table.</p>
      </div>
      <div>
        <div class="display text-[clamp(2rem,3.5vw,2.75rem)] leading-[1.05] tracking-display-tight text-ink">CASCA 2026 · Award of Excellence</div>
        <p class="mt-4 text-[15px] text-ink-2 max-w-[16rem] leading-snug">National recognition for water conservation, presented in New Delhi on Earth Day, 22 April 2026.</p>
      </div>
    </div>
  </section>

  <!-- Status legend + dashboard intro -->
  <section class="py-16">
    <div class="container-content grid lg:grid-cols-[2fr_1fr] gap-12 items-start">
      <div>
        <div class="eyebrow"><span>Programme dashboard</span></div>
        <h2 class="display text-[clamp(2rem,3.5vw,3rem)] leading-[1.05] tracking-display-tight m-0 mb-6">Each pond on the map is a real site.</h2>
        <p class="text-base text-ink-2 leading-relaxed max-w-2xl m-0">
          Each pond is a real site in a partner village. Drill down by state, district and village, or toggle status — nearby ponds group into clusters that open up as you zoom in. Click any pond for its photo, donor and construction details.
        </p>
      </div>
      <div class="bg-paper-alt border border-line p-6">
        <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-accent mb-4">What the statuses mean</div>
        <ul class="space-y-2.5 text-sm text-ink-2 m-0 p-0 list-none">
          <li class="flex gap-2.5"><span class="inline-block h-2.5 w-2.5 rounded-full mt-1.5 shrink-0" style="background:#059669"></span><span><strong class="text-ink">Active</strong> — holding water and recharging the local table.</span></li>
          <li class="flex gap-2.5"><span class="inline-block h-2.5 w-2.5 rounded-full mt-1.5 shrink-0" style="background:#64748b"></span><span><strong class="text-ink">Inactive</strong> — currently dry or out of service.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <ProgramDashboard
    programSlug="jal-vriddhi"
    statuses={statuses}
    unitSingular="Pond"
    unitPlural="Ponds"
    initialData={jalVriddhiDashboard}
  />

  <section class="bg-paper-alt border-y border-line py-16">
    <div class="container-content text-center max-w-2xl mx-auto">
      <p class="text-[17px] text-ink-2 leading-relaxed m-0">
        Data on this page is refreshed regularly from our programme systems and field records. If you'd like to partner with us on Jal Vriddhi — as a village, donor, or volunteer — please get in touch.
      </p>
    </div>
  </section>
</Layout>
