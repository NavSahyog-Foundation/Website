---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatCard from '../../components/StatCard.astro';
import WpImage from '../../components/WpImage.astro';
import { url } from '../../utils/url';

const stories = [
  { name: 'Priyanka', image: 'wp-content/uploads/2023/12/Priyanka-768x1086.png' },
  { name: 'Nithyasree', image: 'wp-content/uploads/2023/12/Nithyasree-768x1086.png' },
  { name: 'Manjunath', image: 'wp-content/uploads/2023/12/Manjunath-768x1086.png' },
  { name: 'Manasa', image: 'wp-content/uploads/2023/12/Manasa-768x1086.png' },
  { name: 'Dhanush', image: 'wp-content/uploads/2023/12/Dhanush-768x1086.png' },
  { name: 'Kavya', image: 'wp-content/uploads/2023/12/Kavya-768x1086.png' },
  { name: 'Chitra Devi', image: 'wp-content/uploads/2023/12/Chitra-Devi-768x1086.png' },
  { name: 'Bhavya J', image: 'wp-content/uploads/2023/12/Bhavya-J-768x1086.jpeg' },
  { name: 'Annu', image: 'wp-content/uploads/2023/12/Annu-768x1086.jpeg' },
  { name: 'Amrutha', image: 'wp-content/uploads/2023/12/Amrutha-768x1086.jpeg' },
];

const studies = [
  { label: 'NavSahyog Foundation — Impact Study March 2025', link: 'https://drive.google.com/file/d/1ib0VvGRVmP-Tn62fq_ZR3hXAF6rj1Kio/view?usp=sharing', external: true },
  { label: 'NavSahyog Foundation — Impact Study March 2024', link: 'https://drive.google.com/file/d/1OVK8ZJr5DHFV5l5lDaxd1vMP1bFaMZiW/view?usp=sharing', external: true },
  { label: 'NavSahyog Foundation — Impact Study March 2023', link: 'https://drive.google.com/file/d/1To2qM-_vXOnH8qxr_jb9bO4MCD4xbSDB/view?usp=drive_link', external: true },
  { label: 'NavSahyog Foundation — Impact Study March 2022', link: '/downloads/impact-study-mar-2022.pdf' },
  { label: 'NavSahyog Foundation — Impact Study March 2021', link: '/downloads/impact-study-mar-2021.pdf' },
  { label: 'NavSahyog Foundation — Impact Study January 2020', link: '/downloads/impact-study-jan-2020.pdf' },
  { label: 'NavSahyog Foundation — Impact Study September 2019', link: '/downloads/impact-study-sep-2019.pdf' },
];
---

<Layout title="Impact" description="NavSahyog Foundation's measured impact — by numbers, by independent studies, and by the children whose lives have changed.">
  <PageHeader
    eyebrow="Impact"
    title="Impact"
    subtitle="At NavSahyog Foundation, we value diversity and inclusiveness."
  />

  <div class="container-content py-16 space-y-16">
    <section class="grid lg:grid-cols-2 gap-10 items-center">
      <WpImage src="wp-content/uploads/2021/07/IMG_20181125_103406741_BURST000_COVER_TOP-930x620.jpg" alt="Children in a NavSahyog programme" class="rounded-xl w-full h-auto" loading="eager" />
      <div>
        <h2 class="text-2xl md:text-3xl font-bold mb-4">Diversity at the core</h2>
        <p class="text-lg text-ink/80 leading-relaxed mb-4">
          At NavSahyog Foundation, we value diversity and inclusiveness. We encourage the
          participation of girls and women in our programme.
        </p>
        <p class="text-lg text-ink/80 leading-relaxed">
          We conduct impact studies to understand the development of life skills and non-life
          skills.
        </p>
      </div>
    </section>

    <section>
      <div class="grid sm:grid-cols-3 gap-5">
        <StatCard value="60%" label="Children in our programme are girls" />
        <StatCard value="97%" label="Of our team members are women" />
        <StatCard value="97%" label="Of those women live in villages" />
      </div>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold mb-6">Stories of Change</h2>
      <p class="text-ink/80 text-lg max-w-3xl mb-8">
        Children who grew up in the NavSahyog programme, now pursuing their dreams.
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
        {stories.map((s) => (
          <figure class="rounded-xl overflow-hidden border border-slate-200 bg-white">
            <WpImage src={s.image} alt={s.name} class="w-full aspect-[3/4] object-cover" />
            <figcaption class="px-4 py-3 text-center">
              <p class="font-semibold text-ink text-sm">{s.name}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold mb-6">Impact Studies</h2>
      <p class="text-ink/80 text-lg max-w-3xl mb-8">
        We commission independent impact studies periodically and publish the full reports.
      </p>
      <ul class="grid md:grid-cols-2 gap-4">
        {studies.map((s) => (
          <li class="rounded-xl border border-slate-200 p-5 bg-white">
            <a
              href={s.external ? s.link : url(s.link)}
              target={s.external ? '_blank' : undefined}
              rel={s.external ? 'noopener' : undefined}
              class="font-semibold text-brand hover:underline"
            >
              {s.label}
            </a>
            <p class="text-sm text-ink/70 mt-1">{s.external ? 'Google Drive ↗' : 'PDF ↓'}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="text-center">
      <a href={url('/impact/testimonials/')} class="btn-outline">Read testimonial videos →</a>
    </section>
  </div>
</Layout>
