---
import Layout from '../../layouts/Layout.astro';
import Img from '../../components/Img.astro';
import { url } from '../../utils/url';

const stories = [
  { name: 'Priyanka', image: '2023/12/Priyanka-768x1086.png' },
  { name: 'Nithyasree', image: '2023/12/Nithyasree-768x1086.png' },
  { name: 'Manjunath', image: '2023/12/Manjunath-768x1086.png' },
  { name: 'Manasa', image: '2023/12/Manasa-768x1086.png' },
  { name: 'Dhanush', image: '2023/12/Dhanush-768x1086.png' },
  { name: 'Kavya', image: '2023/12/Kavya-768x1086.png' },
  { name: 'Chitra Devi', image: '2023/12/Chitra-Devi-768x1086.png' },
  { name: 'Bhavya J', image: '2023/12/Bhavya-J-768x1086.jpeg' },
  { name: 'Annu', image: '2023/12/Annu-768x1086.jpeg' },
  { name: 'Amrutha', image: '2023/12/Amrutha-768x1086.jpeg' },
];

const studies = [
  { label: 'Annual Impact Survey Report 2025–26', date: 'March 2026', link: '/downloads/impact-study-2026.pdf', external: false },
  { label: 'NavSahyog Impact Study — March 2025', date: 'March 2025', link: 'https://drive.google.com/file/d/1ib0VvGRVmP-Tn62fq_ZR3hXAF6rj1Kio/view?usp=sharing', external: true },
  { label: 'NavSahyog Impact Study — March 2024', date: 'March 2024', link: 'https://drive.google.com/file/d/1OVK8ZJr5DHFV5l5lDaxd1vMP1bFaMZiW/view?usp=sharing', external: true },
  { label: 'NavSahyog Impact Study — March 2023', date: 'March 2023', link: 'https://drive.google.com/file/d/1To2qM-_vXOnH8qxr_jb9bO4MCD4xbSDB/view?usp=drive_link', external: true },
  { label: 'NavSahyog Impact Study — March 2022', date: 'March 2022', link: '/downloads/impact-study-mar-2022.pdf', external: false },
  { label: 'NavSahyog Impact Study — March 2021', date: 'March 2021', link: '/downloads/impact-study-mar-2021.pdf', external: false },
  { label: 'NavSahyog Impact Study — January 2020', date: 'January 2020', link: '/downloads/impact-study-jan-2020.pdf', external: false },
  { label: 'NavSahyog Impact Study — September 2019', date: 'September 2019', link: '/downloads/impact-study-sep-2019.pdf', external: false },
];
---

<Layout title="Impact" description="NavSahyog Foundation's measured impact — by numbers, by independent studies, and by the children whose lives have changed.">

  <!-- Editorial hero -->
  <section class="bg-paper">
    <div class="container-content pt-20 md:pt-28 pb-10">
      <div class="eyebrow"><span>Impact</span></div>
      <h1 class="display text-fluid-2 leading-[0.95] tracking-display-tight m-0">
        Measured by <span class="display-italic text-accent">independent</span> studies.<br />
        Felt in the children's voices.
      </h1>
    </div>
  </section>

  <!-- Diversity stats -->
  <section class="py-14 border-y border-line">
    <div class="container-content grid md:grid-cols-3 gap-10 md:gap-14">
      <div>
        <div class="display text-fluid-1 leading-[0.95] tracking-[-0.045em] text-ink">60<span class="text-accent">%</span></div>
        <p class="mt-4 text-sm text-ink-2 max-w-[18rem] leading-snug">Of children in our programme are girls — by intentional design.</p>
      </div>
      <div>
        <div class="display text-fluid-1 leading-[0.95] tracking-[-0.045em] text-ink">97<span class="text-accent">%</span></div>
        <p class="mt-4 text-sm text-ink-2 max-w-[18rem] leading-snug">Of our team members are women.</p>
      </div>
      <div>
        <div class="display text-fluid-1 leading-[0.95] tracking-[-0.045em] text-ink">97<span class="text-accent">%</span></div>
        <p class="mt-4 text-sm text-ink-2 max-w-[18rem] leading-snug">Of those women live in the very villages we serve.</p>
      </div>
    </div>
  </section>

  <!-- Annual Impact Survey 2025–26 highlights -->
  <section class="section-y">
    <div class="container-content grid md:grid-cols-[1fr_1.4fr] gap-12 md:gap-20 items-start">
      <div class="md:sticky md:top-28">
        <div class="eyebrow"><span>Annual Impact Survey · 2025–26</span></div>
        <h2 class="display text-fluid-9 leading-[1.05] tracking-display-tight m-0 mb-5">
          The largest stakeholder survey we've ever run.
        </h2>
        <p class="text-base text-ink-2 leading-relaxed max-w-md">
          18,487 responses across children, parents and teachers — covering 26 life-skill and non-life-skill parameters across Karnataka, Tamil Nadu and Nagaland.
        </p>
        <a href={url('/news/')} class="mt-6 link-arrow font-semibold">Read the full report <span aria-hidden="true">→</span></a>
      </div>
      <div>
        {[
          { v: '75%', l: 'High to Very High impact ratings overall — universal positive impact across children, parents and teachers.' },
          { v: '80.3%', l: 'Children rate Values impact as High — programme strength leader, alongside Water Awareness (~80%) and Sports Interest (80%).' },
          { v: '80.6%', l: 'Tamil Nadu shows the strongest regional impact at High; girls (75.5%) marginally outperform boys (73.6%).' },
          { v: '93%', l: 'Of children attend regularly — and report 74.9% High outcomes. Irregular attendance drops to 58.6%.' },
          { v: '76.7%', l: 'Peak High rating in the 1–2-year tenure cohort — every cohort exceeds 74%, suggesting tenure compounds.' },
          { v: '11% / 21.7%', l: 'Discipline is the top new habit (11%); TV watching is the biggest habit stopped (21.7%), followed by mobile usage (20%) and fighting (13.2%).' },
        ].map((r) => (
          <div class="sm:grid sm:grid-cols-[120px_1fr] md:grid-cols-[140px_1fr] sm:gap-6 md:gap-10 py-6 border-b border-line">
            <div class="display text-3xl md:text-40 leading-none tracking-[-0.04em] text-ink mb-3 sm:mb-0">{r.v}</div>
            <p class="m-0 text-15 leading-relaxed text-ink-2">{r.l}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stories of change -->
  <section class="section-y border-t border-line">
    <div class="container-content">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-14">
        <div>
          <div class="eyebrow"><span>Stories of change</span></div>
          <h2 class="display text-fluid-8 leading-[1.02] tracking-display-tight m-0">The children who grew up here.</h2>
        </div>
        <a href={url('/impact/testimonials/')} class="link-arrow font-semibold">Watch their testimonials <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4 md:gap-5">
        {stories.map((s) => (
          <figure class="m-0">
            <Img src={s.image} alt={s.name} class="w-full aspect-[3/4] object-cover bg-paper-alt" />
            <figcaption class="label-mono tracking-label-08 text-ink-3 mt-2.5">{s.name}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Studies -->
  <section class="section-y bg-paper-alt border-y border-line">
    <div class="container-content">
      <div class="eyebrow"><span>Independent impact studies</span></div>
      <h2 class="display text-fluid-9 leading-[1.05] tracking-display-tight m-0 mb-12 max-w-2xl">Every study we've commissioned. All public.</h2>
      <div class="grid md:grid-cols-2 gap-3">
        {studies.map((s) => (
          <a
            href={s.external ? s.link : url(s.link)}
            target={s.external ? '_blank' : undefined}
            rel={s.external ? 'noopener' : undefined}
            class="bg-paper border border-line p-6 flex items-center justify-between gap-6 hover:border-accent transition-colors group"
          >
            <div>
              <div class="text-15 font-semibold text-ink leading-snug">{s.label}</div>
              <div class="label-mono tracking-label-06 text-ink-3 mt-1.5">{s.date}</div>
            </div>
            <span class="text-accent text-sm font-semibold whitespace-nowrap">{s.external ? 'Drive ↗' : 'PDF ↓'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
