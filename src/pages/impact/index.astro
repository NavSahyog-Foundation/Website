---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatCard from '../../components/StatCard.astro';
import { Image } from 'astro:assets';
import { url } from '../../utils/url';
import heroImg from '../../assets/images/impact-hero.jpg';
import priyanka from '../../assets/images/testimonial-priyanka.png';
import nithyasree from '../../assets/images/testimonial-nithyasree.png';
---

<Layout title="Impact" description="NavSahyog Foundation's measured impact — by numbers, by studies, and by the children whose lives have changed.">
  <PageHeader
    eyebrow="Impact"
    title="Measured Impact"
    subtitle="Every cohort, every year, measured and published — so that every donor rupee is accountable."
  />

  <div class="container-content py-16 space-y-16">
    <section class="grid lg:grid-cols-2 gap-10 items-center">
      <Image src={heroImg} alt="Children in a NavSahyog programme" class="rounded-xl w-full h-auto" />
      <div>
        <h2 class="text-2xl md:text-3xl font-bold mb-4">Diversity at the core</h2>
        <p class="text-lg text-ink/80 leading-relaxed">
          At NavSahyog Foundation, we value diversity and inclusiveness. We actively encourage the
          participation of girls and women — both as children in the programme and as leaders on
          our team.
        </p>
      </div>
    </section>

    <section>
      <div class="grid sm:grid-cols-3 gap-5">
        <StatCard value="60%" label="Children in our programme are girls" />
        <StatCard value="97%" label="Of our team members are women" />
        <StatCard value="97%" label="Of those women live in villages" />
      </div>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold mb-6">Impact Studies</h2>
      <p class="text-ink/80 text-lg max-w-3xl mb-8">
        We commission independent impact studies periodically and publish the full reports.
      </p>
      <ul class="grid md:grid-cols-2 gap-4">
        <li class="rounded-xl border border-slate-200 p-5 bg-white">
          <a href={url('/downloads/impact-study-mar-2022.pdf')} class="font-semibold text-brand hover:underline">
            Impact Study — March 2022
          </a>
          <p class="text-sm text-ink/70 mt-1">PDF · full programme assessment</p>
        </li>
        <li class="rounded-xl border border-slate-200 p-5 bg-white">
          <a href={url('/downloads/impact-study-mar-2021.pdf')} class="font-semibold text-brand hover:underline">
            Impact Study — March 2021
          </a>
          <p class="text-sm text-ink/70 mt-1">PDF · 39-village assessment</p>
        </li>
        <li class="rounded-xl border border-slate-200 p-5 bg-white">
          <a href={url('/downloads/impact-study-jan-2020.pdf')} class="font-semibold text-brand hover:underline">
            Impact Study — January 2020
          </a>
          <p class="text-sm text-ink/70 mt-1">PDF</p>
        </li>
        <li class="rounded-xl border border-slate-200 p-5 bg-white">
          <a href={url('/downloads/impact-study-sep-2019.pdf')} class="font-semibold text-brand hover:underline">
            Impact Study — September 2019
          </a>
          <p class="text-sm text-ink/70 mt-1">PDF</p>
        </li>
      </ul>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-bold mb-6">In their own words</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        <figure class="rounded-xl overflow-hidden border border-slate-200 bg-white">
          <Image src={priyanka} alt="Priyanka — NavSahyog programme alumna" class="w-full h-auto" />
          <figcaption class="p-4">
            <p class="font-semibold">Priyanka</p>
            <p class="text-sm text-ink/70">NavSahyog programme participant</p>
          </figcaption>
        </figure>
        <figure class="rounded-xl overflow-hidden border border-slate-200 bg-white">
          <Image src={nithyasree} alt="Nithyasree — NavSahyog programme alumna" class="w-full h-auto" />
          <figcaption class="p-4">
            <p class="font-semibold">Nithyasree</p>
            <p class="text-sm text-ink/70">NavSahyog programme participant</p>
          </figcaption>
        </figure>
      </div>
      <a href={url('/impact/testimonials/')} class="btn-outline mt-8">Read more testimonials</a>
    </section>
  </div>
</Layout>
