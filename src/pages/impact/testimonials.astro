---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { url } from '../../utils/url';

const categories = [
  {
    heading: 'From the children',
    entries: [
      { label: 'Nityashree, Haralur', type: 'mp4', src: '/videos/untitled-design.mp4' },
      { label: 'Manasa, Thottikuppam', type: 'youtube', id: 'AbHu8llgWIU' },
    ],
    summary: 'Nityashree from Haralur and Manasa from Thottikuppam describe what the programme has been to them.',
  },
  {
    heading: 'From the teachers',
    entries: [
      { label: "A teacher's feedback", type: 'youtube', id: '036u-rKBua0' },
    ],
    summary: 'A teacher from one of our village schools shares how the programme has shaped the children she teaches.',
  },
  {
    heading: 'From the parents',
    entries: [
      { label: 'A parent from Samandhakottai, Denkanikottai', type: 'mp4', src: '/videos/story-video.mp4' },
      { label: 'Anitha (parent) from Enimuchandram, Denkanikottai', type: 'mp4', src: '/videos/feedback-by-anitha.mp4' },
    ],
    summary: 'Parents from Denkanikottai describe what has changed at home — in confidence, in study habits, in how their children carry themselves.',
  },
  {
    heading: 'From the village coordinators',
    entries: [
      { label: 'Village Coordinator Kanaka, Enimuchandram', type: 'youtube', id: 'OaYfepE6xVw' },
      { label: 'Village Coordinator Sudha, Kowthamaranahalli', type: 'mp4', src: '/videos/impact-video-anitha-parent-1.mp4' },
    ],
    summary: 'Our on-ground facilitators — almost all women from the villages themselves — describe the programme from the inside.',
  },
] as const;
---

<Layout title="Testimonials" description="Feedback from children, teachers, parents and village coordinators on NavSahyog Foundation's programme.">
  <PageHeader
    eyebrow="Impact"
    title="The programme through the eyes of those it serves."
    accentWord="those"
    subtitle="And the people who run it — children, teachers, parents and village coordinators."
  />

  <div class="container-content py-12 space-y-20">
    {categories.map((c) => (
      <section>
        <div class="grid md:grid-cols-[1fr_2fr] gap-10 md:gap-16 items-start">
          <div class="md:sticky md:top-28">
            <div class="eyebrow"><span>{c.heading}</span></div>
            <p class="m-0 text-[17px] leading-relaxed text-ink-2 max-w-md">{c.summary}</p>
          </div>
          <div class={`grid ${c.entries.length > 1 ? 'sm:grid-cols-2' : ''} gap-5`}>
            {c.entries.map((e) => (
              <figure class="m-0">
                <div class="aspect-video bg-ink overflow-hidden">
                  {e.type === 'youtube' ? (
                    <iframe
                      class="w-full h-full"
                      src={`https://www.youtube-nocookie.com/embed/${e.id}`}
                      title={e.label}
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                      loading="lazy"
                    ></iframe>
                  ) : (
                    <video controls class="w-full h-full" preload="metadata">
                      <source src={url(e.src)} />
                      Your browser does not support embedded video.
                    </video>
                  )}
                </div>
                <figcaption class="label-mono tracking-label-08 text-ink-3 mt-2.5">{e.label}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    ))}
  </div>
</Layout>
