---

<Layout title="News & Stories" description="From the field, in the press, and from the team — annual reports, video stories, press clippings and events from NavSahyog Foundation.">

  <!-- Hero -->
  <section class="bg-paper">
    <div class="container-content pt-20 md:pt-28 pb-12">
      <div class="eyebrow"><span>News &amp; Stories</span></div>
      <h1 class="display text-fluid-4 leading-[0.98] tracking-display-tight m-0">
        From the field. <span class="display-italic text-accent">In the press.</span>
      </h1>
      <p class="mt-7 text-lg md:text-xl leading-[1.5] text-ink-2 max-w-2xl">
        Annual reports, stories from the field, press clippings, and the events that mark the year — all in one place.
      </p>
      <nav class="label-mono mt-10 flex flex-wrap gap-x-6 gap-y-3 tracking-label-14" aria-label="Page sections">
        {sections.map((s) => (
          <a href={`#${s.id}`} class="text-ink-3 hover:text-accent border-b border-line hover:border-accent pb-1">{s.label} →</a>
        ))}
      </nav>
    </div>
  </section>

  <!-- Featured impact study -->
  <section id="featured" class="section-y-sm border-t border-line scroll-mt-20">
    <div class="container-content">
      <div class="eyebrow"><span>Featured report</span></div>
      <article class="grid md:grid-cols-2 gap-0 bg-paper-alt border border-line">
        <a href={url(impactStudy.pdf)} target="_blank" rel="noopener" class="block group">
          <div class="aspect-[4/3] md:aspect-auto md:h-full bg-paper-alt overflow-hidden">
            <Img src={impactStudy.cover} alt={`${impactStudy.title} cover`} class="w-full h-full object-cover group-hover:opacity-95 transition" loading="eager" />
          </div>
        </a>
        <div class="p-8 md:p-10 flex flex-col">
          <p class="label-mono tracking-label-14 text-accent">{impactStudy.date} · Impact study</p>
          <h3 class="display text-2xl md:text-3xl tracking-display-tight mt-3 mb-5 m-0">{impactStudy.title}</h3>
          <p class="text-15 leading-relaxed text-ink-2 m-0 mb-7">
            Our largest impact survey to date — independent ratings from <strong class="text-ink">6,388 children, 6,294 parents and 5,805 teachers</strong>. The headline: the programme delivers <strong class="text-ink">universal, consistent, age-resilient positive change</strong>.
          </p>

          <div class="grid grid-cols-3 gap-4 mb-7">
            {impactStudy.stats.map((s) => (
              <div class="border-t border-line pt-3">
                <p class="display text-xl md:text-2xl tracking-display-tight m-0 leading-tight">{s.value}</p>
                <p class="font-mono text-eyebrow-sm uppercase tracking-label-08 text-ink-3 mt-2 leading-snug">{s.label}</p>
              </div>
            ))}
          </div>

          <ul class="space-y-2.5 text-[13.5px] text-ink-2 m-0 mb-8 list-disc pl-5 leading-relaxed">
            {impactStudy.highlights.map((h) => (
              <li set:html={h} />
            ))}
          </ul>

          <div class="mt-auto flex flex-wrap gap-3">
            <a href={url(impactStudy.pdf)} target="_blank" rel="noopener" class="btn-primary px-6 py-3 text-sm">Download the full report (PDF) ↓</a>
            <a href={url('/downloads/')} class="btn-outline px-5 py-2.5 text-sm">All impact reports →</a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- Featured story -->
  <section id="story" class="section-y-sm scroll-mt-20">
    <div class="container-content">
      <div class="eyebrow"><span>Featured story</span></div>
      <a href={url(featuredPost.href)} class="group grid md:grid-cols-[1fr_2fr] gap-0 border border-line hover:border-accent transition-colors overflow-hidden">
        <div class="aspect-[4/3] md:aspect-auto bg-paper-alt overflow-hidden">
          <Img src={featuredPost.image} alt={featuredPost.title} class="w-full h-full object-cover group-hover:opacity-95 transition" loading="eager" />
        </div>
        <div class="p-8 md:p-10 bg-paper">
          <p class="label-mono tracking-label-14 text-accent">{featuredPost.date} · Award</p>
          <h3 class="display text-xl md:text-3xl tracking-display-tight mt-3 mb-3 m-0">{featuredPost.title}</h3>
          <p class="text-15 leading-relaxed text-ink-2 m-0">{featuredPost.summary}</p>
          <p class="mt-5 text-sm font-semibold text-accent">Read the story →</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Stories from the field (videos) -->
  <section id="stories" class="section-y-sm border-t border-line scroll-mt-20">
    <div class="container-content">
      <div class="flex items-end justify-between gap-6 mb-10 pb-4 border-b border-ink">
        <div class="eyebrow m-0"><span>Stories from the field</span></div>
        <div class="label-mono tracking-label-12 text-ink-3">{stories.length} videos</div>
      </div>
      <div class="space-y-0">
        {stories.map((p, i) => (
          <a href={p.video} target="_blank" rel="noopener" class:list={['group grid md:grid-cols-[260px_1fr] gap-6 md:gap-10 py-7 hover:bg-paper-alt transition-colors px-2 md:px-4 -mx-2 md:-mx-4', i === 0 ? 'border-t border-line' : 'border-t border-line']}>
            <div class="aspect-video bg-paper-alt overflow-hidden">
              <Img src={p.image} alt={p.title} class="w-full h-full object-cover group-hover:opacity-90 transition" />
            </div>
            <div>
              <p class="label-mono tracking-label-14 text-accent">{p.date}</p>
              <h3 class="display text-xl md:text-2xl tracking-display-tight mt-2 mb-2 m-0">{p.title}</h3>
              <p class="text-14 leading-relaxed text-ink-2 m-0">{p.summary}</p>
              <p class="mt-3 text-sm font-semibold text-accent">Watch on YouTube →</p>
            </div>
          </a>
        ))}
        <div class="border-t border-line"></div>
      </div>
    </div>
  </section>

  <!-- In the press -->
  <section id="press" class="section-y-sm bg-paper-alt border-y border-line scroll-mt-20">
    <div class="container-content">
      <div class="flex items-end justify-between gap-6 mb-10 pb-4 border-b border-ink">
        <div class="eyebrow m-0"><span>In the press</span></div>
        <div class="label-mono tracking-label-12 text-ink-3">{press.length} clippings</div>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {press.map((a) => {
          const Tag = a.link ? 'a' : 'div';
          const extra = a.link ? { href: a.link, target: '_blank', rel: 'noopener' } : {};
          return (
            <Tag class="group block bg-paper border border-line hover:border-accent transition-colors" {...extra}>
              <div class="aspect-[4/3] bg-paper-alt overflow-hidden">
                <Img src={a.image} alt={a.title} class="w-full h-full object-cover group-hover:opacity-95 transition" />
              </div>
              <div class="p-4">
                <p class="label-mono tracking-label-12 text-accent">{a.source}</p>
                <h3 class="display text-base tracking-display-tight font-medium text-ink mt-2 leading-snug m-0">{a.title}</h3>
                {a.link && <p class="mt-2 text-xs text-accent font-semibold">Read article →</p>}
              </div>
            </Tag>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Events -->
  {events.length > 0 && (
    <section id="events" class="section-y-sm border-t border-line scroll-mt-20">
      <div class="container-content">
        <div class="flex items-end justify-between gap-6 mb-10 pb-4 border-b border-ink">
          <div class="eyebrow m-0"><span>Events &amp; celebrations</span></div>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {events.map((e) => (
            <a href={url(`/events/${e.slug}/`)} class="block bg-paper border border-line p-6 hover:border-accent transition-colors">
              {e.data.date && <p class="label-mono tracking-label-14 text-accent">{e.data.date}</p>}
              <h3 class="display text-lg tracking-display-tight font-medium text-ink mt-3 mb-2 m-0">{e.data.title}</h3>
              {e.data.summary && <p class="text-14 text-ink-2 leading-relaxed m-0">{e.data.summary}</p>}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Archive -->
  <section id="archive" class="section-y-sm border-t border-line scroll-mt-20">
    <div class="container-content">
      <div class="flex items-end justify-between gap-6 mb-10 pb-4 border-b border-ink">
        <div class="eyebrow m-0"><span>Archive</span></div>
        <div class="label-mono tracking-label-12 text-ink-3">{archive.length} entries</div>
      </div>
      <Gallery
        images={archive.map((p) => p.image)}
        captions={archive.map((p) => p.title)}
        columns={5}
        group="news-archive"
      />
    </div>
  </section>
</Layout>
