---
import Layout from '../layouts/Layout.astro';
import WpImage from '../components/WpImage.astro';
import { url } from '../utils/url';
---

<Layout title="Home" description="NavSahyog Foundation develops life skills and creativity in village children aged 5–14 through board games, sports, storytelling, creative activities and experiential learning.">
  <!-- Hero -->
  <section class="bg-white">
    <div class="container-content pt-10 pb-6 md:pt-14 md:pb-10">
      <div class="relative rounded-3xl overflow-hidden shadow-xl">
        <WpImage
          src="wp-content/uploads/2026/04/ww-scaled-e1775040670106-930x620.jpg"
          alt="NavSahyog children with the Foundation's logo — Life skills to Livelihood"
          class="w-full h-auto object-cover"
          loading="eager"
        />
      </div>
    </div>
    <div class="container-content pb-14 md:pb-16 text-center">
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold text-[#b83227] leading-tight tracking-tight">
        Developing Life Skills and Creativity<br />in Village children
      </h1>
      <div class="mt-6 flex justify-center gap-4">
        <a href="https://www.facebook.com/navsahyogfoundation/" target="_blank" rel="noopener" aria-label="Facebook" class="text-ink/60 hover:text-brand">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M13 22v-8h2.8l.4-3.2H13V8.7c0-.9.3-1.6 1.6-1.6H16V4.2A22 22 0 0 0 13.9 4c-2.3 0-3.9 1.4-3.9 4v2.8H7.2V14H10v8h3Z"/></svg>
        </a>
        <a href="https://www.instagram.com/navsahyogfoundation/" target="_blank" rel="noopener" aria-label="Instagram" class="text-ink/60 hover:text-brand">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.5 1s.8.9 1 1.5c.2.5.4 1.1.4 2.3.1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-1 1.5s-.9.8-1.5 1c-.5.2-1.1.4-2.3.4-1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.5-1s-.8-.9-1-1.5c-.2-.5-.4-1.1-.4-2.3C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.3-1.8.4-2.2.2-.6.5-1 1-1.5s.9-.8 1.5-1c.5-.2 1.1-.4 2.3-.4C8.4 2.2 8.8 2.2 12 2.2M12 0C8.7 0 8.3 0 7 .1 5.8.1 4.9.3 4.2.6c-.8.3-1.5.7-2.1 1.4S1 3.4.7 4.2c-.3.7-.5 1.6-.6 2.8C0 8.3 0 8.7 0 12s0 3.7.1 4.9c.1 1.3.3 2.1.6 2.9.3.8.7 1.5 1.4 2.1s1.3 1.1 2.1 1.4c.8.3 1.6.5 2.8.6 1.3.1 1.7.1 5 .1s3.7 0 4.9-.1c1.3-.1 2.1-.3 2.9-.6.8-.3 1.5-.7 2.1-1.4s1.1-1.3 1.4-2.1c.3-.8.5-1.6.6-2.9.1-1.3.1-1.7.1-4.9s0-3.7-.1-4.9c-.1-1.3-.3-2.1-.6-2.9-.3-.8-.7-1.5-1.4-2.1s-1.3-1.1-2.1-1.4c-.8-.3-1.6-.5-2.9-.6C15.7 0 15.3 0 12 0zm0 5.8A6.2 6.2 0 1 0 18.2 12 6.2 6.2 0 0 0 12 5.8zm0 10.2A4 4 0 1 1 16 12a4 4 0 0 1-4 4zm6.4-11.8a1.4 1.4 0 1 0 1.4 1.4 1.4 1.4 0 0 0-1.4-1.4z"/></svg>
        </a>
        <a href="https://www.youtube.com/channel/UCOzO0-ZWLIOWjxU2SWwr7OA" target="_blank" rel="noopener" aria-label="YouTube" class="text-ink/60 hover:text-brand">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg>
        </a>
        <a href="https://www.linkedin.com/company/navsahyog-foundation/" target="_blank" rel="noopener" aria-label="LinkedIn" class="text-ink/60 hover:text-brand">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.1a4.2 4.2 0 0 1 3.8-2.1c4 0 4.8 2.6 4.8 6V21h-4v-5.8c0-1.4 0-3.1-1.9-3.1-1.9 0-2.2 1.5-2.2 3V21h-4V9Z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Key stats banner -->
  <section class="bg-brand text-white">
    <div class="container-content py-14 grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      <div>
        <div class="inline-flex w-14 h-14 rounded-full bg-white/15 items-center justify-center mb-3">
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C8 2 5 5 5 9c0 5 7 13 7 13s7-8 7-13c0-4-3-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
        </div>
        <p class="text-4xl md:text-5xl font-bold">350+</p>
        <p class="mt-1 text-white/90 text-lg">Villages</p>
      </div>
      <div>
        <div class="inline-flex w-14 h-14 rounded-full bg-white/15 items-center justify-center mb-3">
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 11a4 4 0 1 0-8 0"/><path d="M3 21v-2a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v2"/></svg>
        </div>
        <p class="text-4xl md:text-5xl font-bold">10,000+</p>
        <p class="mt-1 text-white/90 text-lg">Children</p>
      </div>
      <div>
        <div class="inline-flex w-14 h-14 rounded-full bg-white/15 items-center justify-center mb-3">
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9z"/></svg>
        </div>
        <p class="text-4xl md:text-5xl font-bold">6</p>
        <p class="mt-1 text-white/90 text-lg">Days / Week</p>
      </div>
    </div>
  </section>

  <!-- What we do -->
  <section class="container-content py-16 md:py-20 grid lg:grid-cols-2 gap-10 items-start">
    <div>
      <p class="text-brand font-semibold uppercase tracking-wide text-sm mb-3">What we do</p>
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Life skills through daily engagement.</h2>
      <p class="text-lg text-ink/85 leading-relaxed mb-4">
        At NavSahyog, we develop life skills and creativity in village children aged 5–14 years
        (their most impressionable age) through traditional board games, sports, storytelling,
        creative activities, and experiential learning.
      </p>
      <p class="text-lg text-ink/85 leading-relaxed mb-4">
        We engage children on a daily basis, from Monday to Saturday, throughout the year.
      </p>
      <p class="text-lg text-ink/85 leading-relaxed">
        Our experiential learning is all about children learning about the environment and climate
        change. Here, we have two programmes:
      </p>
      <ul class="mt-6 space-y-4 text-lg">
        <li class="flex gap-3">
          <span class="shrink-0 w-2 h-2 rounded-full bg-brand mt-3"></span>
          <span><strong>Prakriti Prem</strong> — We give a fruit sapling to each child in the village, which they nurture and grow into a fruit tree; we run a competition across clusters of villages.</span>
        </li>
        <li class="flex gap-3">
          <span class="shrink-0 w-2 h-2 rounded-full bg-brand mt-3"></span>
          <span><strong>Jal Vriddhi</strong> — We teach children the value of water and address the depleting water table problem in villages through the co-creation of farm ponds with bunds alongside farmers.</span>
        </li>
      </ul>
    </div>
    <div class="space-y-4">
      <WpImage src="wp-content/uploads/2022/07/IMG-2681-1024x461.jpg" alt="NavSahyog programme in action" class="rounded-xl w-full h-auto shadow-sm" />
      <WpImage src="wp-content/uploads/2026/04/qq.png" alt="NavSahyog programme highlights" class="rounded-xl w-full h-auto shadow-sm" />
    </div>
  </section>

  <!-- Linkages to Livelihood -->
  <section class="bg-surface-soft">
    <div class="container-content py-16 md:py-20">
      <div class="max-w-3xl mb-10">
        <p class="text-brand font-semibold uppercase tracking-wide text-sm mb-3">Linkages to Livelihood</p>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">From life skills to livelihood.</h2>
        <p class="text-lg text-ink/85 leading-relaxed">
          We have added extensions to our core programme of life skills development to address
          better linkages of life skills to livelihood.
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-5">
        <div class="rounded-xl border border-slate-200 p-6 bg-white">
          <h3 class="text-xl font-bold text-brand mb-2">Dhan Kaushal</h3>
          <p class="text-ink/80">Financial literacy for children and youth.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-6 bg-white">
          <h3 class="text-xl font-bold text-brand mb-2">Yuva Samriddhi</h3>
          <p class="text-ink/80">Self-employment training for rural youth in collaboration with CBD-RSETI at Haliyal, Karnataka.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-6 bg-white md:col-span-2">
          <h3 class="text-xl font-bold text-brand mb-2">Vanya Samriddhi</h3>
          <p class="text-ink/80">
            Development of food forests on one acre or more barren land of farmers. This significantly
            enhances farmers' productivity, makes them more resilient to climate change, opens
            livelihood opportunities for rural youth, and leads to positive climate action in the villages.
          </p>
        </div>
      </div>
      <div class="mt-10">
        <a href={url('/program/projects/')} class="btn-outline">Explore our projects</a>
      </div>
    </div>
  </section>

  <!-- Vision & Mission -->
  <section class="container-content py-16 md:py-20">
    <div class="grid md:grid-cols-2 gap-10">
      <div class="rounded-2xl border border-slate-200 p-8 md:p-10 bg-white shadow-sm">
        <p class="text-brand font-semibold uppercase tracking-wide text-sm mb-3">Vision</p>
        <h3 class="text-2xl md:text-3xl font-bold mb-4">
          A world where children in villages pursue their dreams and create superior livelihoods for themselves and others.
        </h3>
        <div class="grid grid-cols-2 gap-4 mt-6">
          <WpImage src="wp-content/uploads/2026/04/ss.png" alt="Vision" class="rounded-xl w-full h-auto" />
          <WpImage src="wp-content/uploads/2021/07/Presentation1-300x276.jpg" alt="Vision illustration" class="rounded-xl w-full h-auto" />
        </div>
      </div>
      <div class="rounded-2xl border border-slate-200 p-8 md:p-10 bg-brand text-white shadow-sm">
        <p class="text-white/80 font-semibold uppercase tracking-wide text-sm mb-3">Mission</p>
        <h3 class="text-2xl md:text-3xl font-bold mb-4">
          Impact 100,000 children with life skills &amp; enable superior livelihood for 3,000 youth in villages by 2030.
        </h3>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={url('/about/our-story/')} class="btn bg-white text-brand hover:bg-white/90">Our story</a>
          <a href={url('/program/presence/')} class="btn border border-white/60 text-white hover:bg-white/10">Where we work</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Partner CTA -->
  <section class="container-content py-14 text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-3">Want to partner with us?</h2>
    <p class="text-lg text-ink/80 max-w-2xl mx-auto mb-8">
      Every rupee, every hour, every connection helps a village child take the first step from life
      skills to livelihood.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href={url('/donate/')} class="btn-primary">Donate</a>
      <a href={url('/downloads/')} class="btn-outline">Download our implementation document</a>
    </div>
    <div class="max-w-3xl mx-auto mt-12">
      <WpImage src="wp-content/uploads/2026/03/ooo.png" alt="Our partners and supporters" class="w-full h-auto rounded-xl" />
    </div>
  </section>

  <!-- Photo Gallery (25 images) -->
  <section class="container-content py-16">
    <h2 class="text-2xl md:text-3xl font-bold mb-8 text-center">Photo Gallery</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
      {[
        { src: 'wp-content/uploads/2021/07/fbfb.jpg', caption: 'Boys Kabaddi' },
        { src: 'wp-content/uploads/2021/07/Capture3-1.jpg', caption: 'Girls Kabaddi' },
        { src: 'wp-content/uploads/2021/07/Capture2-1.jpg', caption: 'Kho-Kho' },
        { src: 'wp-content/uploads/2021/11/IMG-20201027-WA0101-1.jpg', caption: 'Running Race' },
        { src: 'wp-content/uploads/2021/07/Goat-and-Tiger-Game.jpg', caption: 'Children enjoying Goat and Tiger' },
        { src: 'wp-content/uploads/2021/11/WhatsApp-Image-2021-09-25-at-10.51.59.jpg', caption: 'High Jump' },
        { src: 'wp-content/uploads/2021/07/ghg.jpg', caption: 'Children playing Board games' },
        { src: 'wp-content/uploads/2021/11/IMG-20210829-WA0037.jpg', caption: 'Thaayam Board game' },
        { src: 'wp-content/uploads/2021/07/2.jpg', caption: 'Board games with family' },
        { src: 'wp-content/uploads/2021/07/fgf-1.jpg', caption: 'Children adhering to Covid Protocols' },
        { src: 'wp-content/uploads/2021/07/Yoga.jpg', caption: 'Children performing Yoga' },
        { src: 'wp-content/uploads/2021/11/IMG-20210308-WA0091-1.jpg', caption: 'Yoga, Haliyal Cluster' },
        { src: 'wp-content/uploads/2021/07/IMG-20210619-WA0016.jpg', caption: 'Daily Activities — Meditation' },
        { src: 'wp-content/uploads/2021/07/fgfgf.jpg', caption: 'Chakrasana — child from Inapura, Tumkur' },
        { src: 'wp-content/uploads/2021/07/Capture5.jpg', caption: 'Star of the Month — with grandmother' },
        { src: 'wp-content/uploads/2021/07/Girls-with-cert.jpg', caption: 'Girls with their medals' },
        { src: 'wp-content/uploads/2021/07/Projetc-bon.jpg', caption: 'Girls planting saplings' },
        { src: 'wp-content/uploads/2021/07/yjyj.jpg', caption: 'Reusing coconut shells to grow plants' },
        { src: 'wp-content/uploads/2021/07/lllii.jpg', caption: 'Honnudikki — World Environment Day saplings' },
        { src: 'wp-content/uploads/2021/07/Goat-and-Tiger-Game-1.jpg', caption: 'Drawings by girls, Haliyal Cluster' },
        { src: 'wp-content/uploads/2021/07/gjfdv.jpg', caption: 'Drawings themed on nature' },
        { src: 'wp-content/uploads/2021/07/yjhjhk.jpg', caption: 'Art — Happy International Yoga Day' },
        { src: 'wp-content/uploads/2021/07/IMG-20210621-WA0036.jpg', caption: 'Art for International Yoga Day 2021' },
        { src: 'wp-content/uploads/2022/05/192421519_296559592163787_7961964084391222623_n.jpg', caption: 'Creative activities by children' },
        { src: 'wp-content/uploads/2022/07/IMG-2679.jpg', caption: 'Creative activity — World Environment Day' },
      ].map((g) => (
        <figure class="rounded-lg overflow-hidden bg-white border border-slate-200 group">
          <WpImage src={g.src} alt={g.caption} class="w-full h-44 sm:h-48 object-cover group-hover:scale-105 transition-transform duration-300" />
          <figcaption class="px-3 py-2 text-xs text-ink/80 bg-white">{g.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- UN SDGs -->
  <section class="bg-surface-soft">
    <div class="container-content py-16">
      <div class="max-w-3xl mb-10">
        <p class="text-brand font-semibold uppercase tracking-wide text-sm mb-3">UN SDG &amp; NavSahyog Foundation</p>
        <h2 class="text-2xl md:text-3xl font-bold mb-3">Our alignment to Sustainable Development.</h2>
        <p class="text-ink/80 text-lg leading-relaxed">
          NavSahyog Foundation is aligned to several sub-goals of select UN SDGs.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-6 mt-10">
        <WpImage src="wp-content/uploads/2021/07/vcvfvf-150x150.jpg" alt="UN SDG preview" class="h-20 w-auto rounded" />
        <WpImage src="wp-content/uploads/2024/09/SDG4-768x768.png" alt="UN SDG 4 — Quality Education" class="h-24 w-24" />
        <WpImage src="wp-content/uploads/2021/07/E_SDG-goals_icons-individual-rgb-05.jpg" alt="UN SDG 5 — Gender Equality" class="h-24 w-24" />
        <WpImage src="wp-content/uploads/2021/07/E_SDG-goals_icons-individual-rgb-08-1024x1024.png" alt="UN SDG 8 — Decent Work and Economic Growth" class="h-24 w-24" />
        <WpImage src="wp-content/uploads/2021/07/E_SDG-goals_icons-individual-rgb-10-300x300.png" alt="UN SDG 10 — Reduced Inequalities" class="h-24 w-24" />
        <WpImage src="wp-content/uploads/2024/09/Goal-13.jpg" alt="UN SDG 13 — Climate Action" class="h-24 w-24" />
        <WpImage src="wp-content/uploads/2021/07/E_SDG-goals_icons-individual-rgb-16-1024x1024.png" alt="UN SDG 16 — Peace, Justice and Strong Institutions" class="h-24 w-24" />
      </div>
    </div>
  </section>
</Layout>
