---
import Layout from '../layouts/Layout.astro';
import Img from '../components/Img.astro';
import StatCard from '../components/StatCard.astro';
import { url } from '../utils/url';

const heroImage = '2026/04/ww-scaled-e1775040670106-930x620.jpg';

const programmes = [
  {
    num: '01',
    name: 'Prakriti Prem',
    tag: 'Ages 5–14',
    body: 'Each child receives a fruit sapling, nurtures it into a tree, and competes across village clusters — rooted environmental learning from the youngest age.',
    href: url('/program/intervention/'),
  },
  {
    num: '02',
    name: 'Jal Vriddhi',
    tag: 'Ages 8–14',
    body: 'Children co-create farm ponds and bunds with farmers — learning the value of water while addressing the depleting water table.',
    href: url('/program/jal-vriddhi/'),
  },
  {
    num: '03',
    name: 'Dhan Kaushal',
    tag: 'Ages 12+',
    body: 'Financial literacy for children and youth — accounts, budgets, savings, and the basics of starting an enterprise.',
    href: url('/program/projects/'),
  },
  {
    num: '04',
    name: 'Yuva Samriddhi',
    tag: 'Ages 16–24',
    body: 'Self-employment training for rural youth, in collaboration with CBD-RSETI at Haliyal, Karnataka.',
    href: url('/program/projects/'),
  },
  {
    num: '05',
    name: 'Vanya Samriddhi',
    tag: 'Adults',
    body: 'Food forests on barren farmer land — climate-resilient livelihoods that close the loop from life skills to enterprise.',
    href: url('/program/projects/'),
  },
];

const photoEssay = [
  { src: '2021/11/WhatsApp-Image-2021-09-25-at-10.51.59.jpg', caption: 'High Jump · Cluster competition', col: 'span 5', ratio: 'aspect-[4/5]' },
  { src: '2021/07/Yoga.jpg', caption: 'Daily yoga · Inapura, Tumkur', col: 'span 7', ratio: 'aspect-[16/9]' },
  { src: '2021/07/Goat-and-Tiger-Game.jpg', caption: 'Aadu Puli · Goat and Tiger', col: 'span 4', ratio: 'aspect-square' },
  { src: '2021/07/Capture3-1.jpg', caption: "Girls' Kabaddi", col: 'span 3', ratio: 'aspect-square' },
];

const presence = [
  ['Karnataka', '8 clusters'],
  ['Tamil Nadu', '8 clusters'],
  ['Nagaland', '2 clusters'],
  ['Districts', '12+'],
];

const trust = ['Section 8 Company', '80G tax-exempt', 'FCRA #094421912', 'Annual independent impact studies'];
---

<Layout title="Home" description="NavSahyog Foundation develops life skills and creativity in village children aged 5–14 through games, sport, story and the soil of their own land — across 350+ villages in Karnataka, Tamil Nadu and Nagaland.">

  <!-- Magazine hero — intentionally bespoke (not the shared Hero component):
       a hand-set two-line title with <br>, a <strong> inside the lede, a larger
       fluid size (fluid-2) and tighter padding than interior-page heroes. -->
  <section class="bg-paper">
    <div class="container-content pt-16 md:pt-20 pb-20">
      <div class="grid md:grid-cols-[1.3fr_1fr] gap-12 lg:gap-16 items-end">
        <div>
          <div class="eyebrow"><span>Life skills · then livelihood</span></div>
          <h1 class="display text-fluid-2 leading-[0.95] tracking-display-tight m-0">
            Life skills.<br />
            <span class="display-italic text-accent">Then</span> livelihood.
          </h1>
          <p class="mt-8 text-lg md:text-21 leading-[1.45] text-ink-2 max-w-xl">
            Across <strong class="text-ink">350+ villages</strong> in India, we work with children aged 5–14 — daily, Monday through Saturday — through games, sport, story, and the soil of their own land.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={url('/donate/')} class="btn-primary px-8 py-4 text-base">Make a gift</a>
            <a href={url('/about/our-story/')} class="btn-outline px-7 py-3.5 text-base">Read our story</a>
          </div>
        </div>
        <div class="relative">
          <Img
            src={heroImage}
            alt="NavSahyog children with the Foundation's logo — Life skills to Livelihood"
            class="w-full h-auto object-cover aspect-[3/4]"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Statline -->
  <section class="bg-paper border-y border-line">
    <div class="container-content py-16 grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-10 md:gap-12">
      <StatCard eyebrow="Reach" value="350+" label="Villages across Karnataka, Tamil Nadu and Nagaland" />
      <StatCard eyebrow="Children" value="10,000+" label="Engaged daily through sport, story and games" />
      <StatCard eyebrow="Mission" value="100,000" label="Children with life skills · target by 2030" />
      <StatCard eyebrow="Cadence" value="6" label="Days a week. Every week. All year." />
    </div>
  </section>

  <!-- The Work -->
  <section class="section-y">
    <div class="container-content grid md:grid-cols-[1fr_1.2fr] gap-16 lg:gap-24 items-start">
      <div class="md:sticky md:top-28">
        <div class="eyebrow"><span>The Work</span></div>
        <h2 class="display text-fluid-7 leading-[1] m-0 tracking-display-tight">
          Five programmes.<br />One <span class="display-italic text-accent">arc</span>.
        </h2>
        <p class="mt-7 text-17 leading-relaxed text-ink-2 max-w-md">
          We start with the youngest children at the most impressionable age — and don't stop until they're earning their own way as adults.
        </p>
      </div>
      <div>
        {programmes.map((p, i) => (
          <a
            href={p.href}
            class:list={[
              'block md:grid md:grid-cols-[60px_1fr_auto] md:gap-8 py-7 md:py-8 group',
              i === 0 ? 'border-t border-ink' : 'border-t border-line',
            ]}
          >
            <div class="flex items-center justify-between mb-3 md:mb-0 md:block md:pt-1">
              <div class="font-mono text-13 text-ink-3">{p.num}</div>
              <div class="label-mono tracking-label-10 text-ink-3 whitespace-nowrap md:hidden">{p.tag}</div>
            </div>
            <div>
              <h3 class="display text-2xl md:text-28 font-medium tracking-display-tight m-0 mb-2 group-hover:text-accent">{p.name}</h3>
              <p class="m-0 text-15 leading-relaxed text-ink-2">{p.body}</p>
            </div>
            <div class="label-mono hidden md:block tracking-label-10 text-ink-3 text-right pt-1 whitespace-nowrap">{p.tag}</div>
          </a>
        ))}
        <div class="border-t border-line"></div>
      </div>
    </div>
  </section>

  <!-- Photo essay -->
  <section class="pb-24 md:pb-32">
    <div class="container-content grid grid-cols-12 gap-4">
      <figure class="m-0 col-span-12 md:col-span-5">
        <Img src={photoEssay[0].src} alt={photoEssay[0].caption} class="w-full aspect-[4/5] object-cover bg-paper-alt" />
        <figcaption class="label-mono tracking-label-08 text-ink-3 mt-2.5">{photoEssay[0].caption}</figcaption>
      </figure>
      <div class="col-span-12 md:col-span-7 flex flex-col gap-4">
        <figure class="m-0">
          <Img src={photoEssay[1].src} alt={photoEssay[1].caption} class="w-full aspect-video object-cover bg-paper-alt" />
          <figcaption class="label-mono tracking-label-08 text-ink-3 mt-2.5">{photoEssay[1].caption}</figcaption>
        </figure>
        <div class="grid grid-cols-2 gap-4">
          <figure class="m-0">
            <Img src={photoEssay[2].src} alt={photoEssay[2].caption} class="w-full aspect-square object-cover bg-paper-alt" />
            <figcaption class="label-mono tracking-label-08 text-ink-3 mt-2.5">{photoEssay[2].caption}</figcaption>
          </figure>
          <figure class="m-0">
            <Img src={photoEssay[3].src} alt={photoEssay[3].caption} class="w-full aspect-square object-cover bg-paper-alt" />
            <figcaption class="label-mono tracking-label-08 text-ink-3 mt-2.5">{photoEssay[3].caption}</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- Independent impact study slab -->
  <section class="bg-paper-alt border-y border-line section-y">
    <div class="container-content max-w-4xl">
      <div class="eyebrow"><span>Annual Impact Survey 2025–26</span></div>
      <blockquote class="display-italic text-fluid-8 leading-[1.15] m-0 mb-12 text-ink">
        "Universal positive impact across children, parents and teachers — 74–75% rate the change as High to Very High across all 26 life-skill and non-life-skill parameters."
      </blockquote>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-7 sm:gap-8 md:gap-12 mt-10 pt-10 border-t border-line">
        <div>
          <div class="display text-fluid-9 leading-none text-ink">18,487</div>
          <div class="mt-3 text-sm text-ink-2 max-w-[14rem] leading-snug">Stakeholder responses across children, parents &amp; teachers</div>
        </div>
        <div>
          <div class="display text-fluid-9 leading-none text-ink">75<span class="text-accent">%</span></div>
          <div class="mt-3 text-sm text-ink-2 max-w-[14rem] leading-snug">High to Very High impact ratings overall</div>
        </div>
        <div>
          <div class="display text-fluid-9 leading-none text-ink">3</div>
          <div class="mt-3 text-sm text-ink-2 max-w-[14rem] leading-snug">States — Karnataka, Tamil Nadu, Nagaland</div>
        </div>
      </div>
      <div class="mt-10">
        <a href={url('/news/')} class="link-arrow font-medium">
          Read the full report <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Linkages to livelihood -->
  <section class="section-y">
    <div class="container-content grid md:grid-cols-[1fr_1fr] gap-16 items-start">
      <div>
        <div class="eyebrow"><span>Linkages to Livelihood</span></div>
        <h2 class="display text-fluid-7 leading-[1] m-0 tracking-display-tight">
          From life skills<br />to <span class="display-italic text-accent">livelihood</span>.
        </h2>
        <p class="mt-7 text-17 leading-relaxed text-ink-2 max-w-md">
          We have added extensions to our core programme of life skills development to address better linkages of life skills to livelihood — culminating in food forests, financial literacy, and self-employment.
        </p>
        <a href={url('/program/projects/')} class="mt-8 link-arrow font-semibold">
          Explore our projects <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="grid gap-px bg-line border border-line">
        <div class="bg-paper p-7">
          <div class="label-mono tracking-label-12 text-accent mb-3">Dhan Kaushal</div>
          <p class="m-0 text-15 leading-relaxed text-ink-2">Financial literacy for children and youth — accounts, budgets, and the basics of starting an enterprise.</p>
        </div>
        <div class="bg-paper p-7">
          <div class="label-mono tracking-label-12 text-accent mb-3">Yuva Samriddhi</div>
          <p class="m-0 text-15 leading-relaxed text-ink-2">Self-employment training for rural youth in collaboration with CBD-RSETI at Haliyal, Karnataka.</p>
        </div>
        <div class="bg-paper p-7">
          <div class="label-mono tracking-label-12 text-accent mb-3">Vanya Samriddhi</div>
          <p class="m-0 text-15 leading-relaxed text-ink-2">Food forests on one or more acres of barren farmer land — productivity, climate resilience, and rural livelihood opportunity.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Where we work -->
  <section class="section-y border-t border-line">
    <div class="container-content grid md:grid-cols-2 gap-16 lg:gap-24 items-center">
      <div>
        <div class="eyebrow"><span>Presence</span></div>
        <h2 class="display text-fluid-7 leading-[1] m-0 tracking-display-tight">
          Where we <span class="display-italic">work</span>.
        </h2>
        <p class="mt-7 text-17 leading-relaxed text-ink-2 max-w-md">
          18 village clusters. Three states. Each one chosen for its remoteness and the strength of its local champions.
        </p>
        <div class="mt-10 grid grid-cols-2 gap-5">
          {presence.map(([k, v]) => (
            <div class="border-t border-line pt-4">
              <div class="label-mono tracking-label-12 text-ink-3">{k}</div>
              <div class="display text-2xl mt-1">{v}</div>
            </div>
          ))}
        </div>
        <a href={url('/program/presence/')} class="mt-10 link-arrow font-semibold">
          See all clusters <span aria-hidden="true">→</span>
        </a>
      </div>
      <Img src="2023/09/NSF-Presence-v-1-768x903.png" alt="NavSahyog Foundation presence map — Karnataka, Tamil Nadu and Nagaland" class="w-full h-auto object-contain bg-paper-alt p-6" />
    </div>
  </section>

  <!-- Donor appeal -->
  <section class="bg-ink text-paper section-y">
    <div class="container-content grid md:grid-cols-2 gap-16 lg:gap-20 items-center">
      <div>
        <div class="eyebrow"><span>Support our work</span></div>
        <h2 class="display text-fluid-6 leading-[1] m-0 mb-7 text-paper">
          Daily engagement, <span class="display-italic text-accent">every day</span>.
        </h2>
        <p class="text-lg leading-relaxed text-paper/75 max-w-md mb-9">
          Every contribution directly funds a child's daily session — sports, storytelling, learning, creativity — Monday to Saturday, throughout the year. 80G-eligible for Indian donors. FCRA-registered for international.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={url('/donate/')} class="bg-accent text-white px-8 py-4 rounded-full text-base font-semibold hover:bg-accent-deep hover:-translate-y-px transition-all">Donate now →</a>
          <a href={url('/contact/')} class="border-[1.5px] border-paper/35 text-paper px-7 py-3.5 rounded-full text-base font-medium hover:bg-paper hover:text-ink transition-colors">Talk to Paritosh</a>
        </div>
      </div>
      <div class="grid gap-6">
        <div class="border-b border-paper/15 pb-6">
          <div class="label-mono tracking-label-16 text-accent mb-3">Mission · 2030</div>
          <div class="display text-4xl md:text-5xl font-medium tracking-display-tight">100,000 children</div>
          <p class="text-15 text-paper/70 mt-2">with life skills, plus 3,000 rural youth enabled for superior livelihood.</p>
        </div>
        <div class="border-b border-paper/15 pb-6">
          <div class="label-mono tracking-label-16 text-accent mb-3">Jal Vriddhi · to date</div>
          <div class="display text-4xl md:text-5xl font-medium tracking-display-tight">280<span class="text-accent">+</span> ponds · 200M L<span class="text-accent">/yr</span></div>
          <p class="text-15 text-paper/70 mt-2">Farm ponds and bunds co-created with farmers; rainwater percolated annually.</p>
        </div>
        <div>
          <div class="label-mono tracking-label-16 text-accent mb-3">Diversity</div>
          <div class="display text-4xl md:text-5xl font-medium tracking-display-tight">60<span class="text-accent">% girls</span> · 97<span class="text-accent">% women</span></div>
          <p class="text-15 text-paper/70 mt-2">Of children in programme are girls — by intentional design. Of our team are women, almost all from the villages we serve.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- UN SDGs -->
  <section class="py-20 md:py-24 border-t border-line">
    <div class="container-content">
      <div class="max-w-2xl mb-10">
        <div class="eyebrow"><span>UN SDG · NavSahyog Foundation</span></div>
        <h2 class="display text-fluid-10 leading-tight tracking-display-tight m-0">
          Aligned with select Sustainable Development Goals.
        </h2>
      </div>
      <div class="flex flex-wrap items-center gap-6 md:gap-10">
        <Img src="2024/09/SDG4-768x768.png" alt="UN SDG 4 — Quality Education" class="h-20 w-20 object-contain" />
        <Img src="2021/07/E_SDG-goals_icons-individual-rgb-05.jpg" alt="UN SDG 5 — Gender Equality" class="h-20 w-20 object-contain" />
        <Img src="2021/07/E_SDG-goals_icons-individual-rgb-08-1024x1024.png" alt="UN SDG 8 — Decent Work and Economic Growth" class="h-20 w-20 object-contain" />
        <Img src="2021/07/E_SDG-goals_icons-individual-rgb-10-300x300.png" alt="UN SDG 10 — Reduced Inequalities" class="h-20 w-20 object-contain" />
        <Img src="2024/09/Goal-13.jpg" alt="UN SDG 13 — Climate Action" class="h-20 w-20 object-contain" />
        <Img src="2021/07/E_SDG-goals_icons-individual-rgb-16-1024x1024.png" alt="UN SDG 16 — Peace, Justice and Strong Institutions" class="h-20 w-20 object-contain" />
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="py-14 border-t border-line">
    <div class="container-content flex flex-wrap items-center justify-between gap-x-12 gap-y-4">
      <div class="label-mono tracking-label-18 text-ink-3">Audited &amp; Registered</div>
      {trust.map((b) => (
        <div class="chip font-medium text-ink-2">{b}</div>
      ))}
    </div>
  </section>
</Layout>
