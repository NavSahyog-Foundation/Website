---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../utils/url';

const contacts = [
  {
    name: 'Paritosh Segal',
    role: 'Strategy & Growth',
    email: 'paritosh.segal@gmail.com',
    phone: '+91 98866 24000',
    phoneLink: '+919886624000',
  },
  {
    name: 'Mary Dolly',
    role: 'Chief Executive Officer',
    email: 'marydolly190@gmail.com',
    phone: '+91 99452 23897',
    phoneLink: '+919945223897',
  },
];

const social = [
  { label: 'Facebook', href: 'https://www.facebook.com/navsahyogfoundation/' },
  { label: 'Instagram', href: 'https://www.instagram.com/navsahyogfoundation/' },
  { label: 'YouTube', href: 'https://www.youtube.com/channel/UCOzO0-ZWLIOWjxU2SWwr7OA' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/navsahyog-foundation/' },
];
---

<Layout title="Contact Us" description="Reach NavSahyog Foundation in Bengaluru — office, email, phone.">
  <PageHeader
    eyebrow="Get in touch"
    title="We'd love to hear from you."
    accentWord="hear"
    subtitle="From donors and partners to volunteers and well-wishers — write, call, or stop by the office."
  />

  <div class="container-content py-12 md:py-16 grid lg:grid-cols-[3fr_2fr] gap-12">
    <div class="space-y-12">
      <!-- Office -->
      <section>
        <div class="eyebrow"><span>Our office</span></div>
        <address class="not-italic text-2xl md:text-3xl text-ink leading-snug display tracking-display-tight font-medium m-0">
          B-104, Shobha Garnet,<br />
          Sarjapur Road, Iblur,<br />
          Bengaluru — 560 102
        </address>
        <p class="mt-5 font-mono text-eyebrow-lg uppercase tracking-label-12 text-ink-3">www.navsahyog.org · Karnataka, India</p>
      </section>

      <!-- People -->
      <section>
        <div class="flex items-end justify-between gap-6 mb-8 pb-4 border-b border-ink">
          <div class="eyebrow m-0"><span>Talk to a person</span></div>
        </div>
        <div class="grid sm:grid-cols-2 gap-x-8 gap-y-8">
          {contacts.map((c) => (
            <div class="border-t border-line pt-5">
              <div class="display text-xl tracking-display-tight">{c.name}</div>
              <div class="label-mono tracking-label-12 text-ink-3 mt-1.5 mb-4">{c.role}</div>
              <p class="text-sm m-0">
                <a href={`mailto:${c.email}`} class="text-accent hover:text-accent-deep break-all">{c.email}</a>
              </p>
              <p class="text-sm m-0 mt-1">
                <a href={`tel:${c.phoneLink}`} class="text-ink hover:text-accent">{c.phone}</a>
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- Send message -->
      <section>
        <div class="flex items-end justify-between gap-6 mb-8 pb-4 border-b border-ink">
          <div class="eyebrow m-0"><span>Send a message</span></div>
        </div>
        <p class="text-base text-ink-2 mb-8 max-w-2xl">Fill in your name and message — we'll open your email app with everything filled in.</p>
        <form
          method="get"
          action="mailto:paritosh.segal@gmail.com"
          class="space-y-5"
          onsubmit="event.preventDefault(); const f=event.target; window.location.href='mailto:paritosh.segal@gmail.com?subject='+encodeURIComponent('Website enquiry from '+f.name.value)+'&body='+encodeURIComponent(f.message.value+'\n\n— '+f.name.value+'\n'+f.email.value);"
        >
          <div class="grid sm:grid-cols-2 gap-5">
            <label class="block">
              <span class="label-mono tracking-label-14 text-ink-3 block mb-2">Name</span>
              <input name="name" type="text" required class="w-full bg-paper border-b border-ink px-0 py-2.5 text-[15px] focus:border-accent outline-none" />
            </label>
            <label class="block">
              <span class="label-mono tracking-label-14 text-ink-3 block mb-2">Email</span>
              <input name="email" type="email" required class="w-full bg-paper border-b border-ink px-0 py-2.5 text-[15px] focus:border-accent outline-none" />
            </label>
          </div>
          <label class="block">
            <span class="label-mono tracking-label-14 text-ink-3 block mb-2">Message</span>
            <textarea name="message" required rows="5" class="w-full bg-paper border border-line p-4 text-[15px] focus:border-accent outline-none resize-y"></textarea>
          </label>
          <button type="submit" class="btn-primary px-7 py-3.5">Send →</button>
        </form>
      </section>

      <!-- Follow -->
      <section>
        <div class="flex items-end justify-between gap-6 mb-6 pb-4 border-b border-ink">
          <div class="eyebrow m-0"><span>Follow us</span></div>
        </div>
        <div class="flex flex-wrap gap-2.5">
          {social.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              class="text-sm px-4 py-2 border border-line rounded-full text-ink-2 hover:border-accent hover:text-accent transition-colors"
            >
              {s.label}
            </a>
          ))}
        </div>
      </section>
    </div>

    <aside class="space-y-5 lg:sticky lg:top-28 self-start">
      <div class="bg-ink text-paper p-7">
        <div class="label-mono tracking-label-14 text-accent mb-4">Ways to support</div>
        <ul class="space-y-2.5 text-[14px] text-paper/85 list-none m-0 p-0 leading-relaxed">
          <li>Donate online in minutes</li>
          <li>Sponsor a village cohort</li>
          <li>Partner as a company or family foundation</li>
          <li>Volunteer your skills (writing, design, audit, mentorship)</li>
        </ul>
        <a href={url('/donate/')} class="inline-flex items-center gap-2 bg-accent text-white px-6 py-3 rounded-full text-[14px] font-semibold mt-6 hover:bg-accent-deep">Donate now <span aria-hidden="true">→</span></a>
      </div>

      <div class="bg-paper-alt border border-line p-7">
        <div class="label-mono tracking-label-14 text-accent mb-3">Registered as</div>
        <p class="text-[14px] text-ink-2 leading-relaxed m-0">
          A Section 8, not-for-profit company registered in India. Donations are eligible for tax deduction under Section 80G. FCRA-registered for international donations.
        </p>
      </div>
    </aside>
  </div>
</Layout>
