---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../utils/url';

const contacts = [
  {
    name: 'Paritosh Segal',
    role: 'Strategy & Growth',
    email: 'paritosh.segal@gmail.com',
    phone: '+91 98866 24000',
    phoneLink: '+919886624000',
  },
  {
    name: 'Mary Dolly',
    role: 'Chief Executive Officer',
    email: 'marydolly190@gmail.com',
    phone: '+91 99452 23897',
    phoneLink: '+919945223897',
  },
];
---

<Layout title="Contact Us" description="Reach NavSahyog Foundation in Bengaluru — office, email, phone.">
  <PageHeader eyebrow="Get in touch" title="Contact Us" subtitle="We'd love to hear from donors, partners, volunteers and well-wishers." />

  <div class="container-content py-16 grid lg:grid-cols-5 gap-10">
    <!-- Office + contacts -->
    <div class="lg:col-span-3 space-y-8">
      <div class="rounded-xl border border-slate-200 p-8 bg-white">
        <h2 class="text-2xl font-bold mb-2">Our Office</h2>
        <address class="not-italic text-lg text-ink/85 leading-relaxed">
          B-104, Shobha Garnet,<br />
          Sarjapur Road, Iblur,<br />
          Bengaluru — 560 102,<br />
          Karnataka, India
        </address>
        <p class="mt-4 text-sm text-ink/70">www.navsahyog.org</p>
      </div>

      <div class="grid sm:grid-cols-2 gap-5">
        {contacts.map((c) => (
          <div class="rounded-xl border border-slate-200 p-6 bg-white">
            <p class="font-semibold text-ink text-lg">{c.name}</p>
            <p class="text-sm text-ink/70 mb-3">{c.role}</p>
            <p class="text-sm">
              <a href={`mailto:${c.email}`} class="text-brand hover:underline break-all">{c.email}</a>
            </p>
            <p class="text-sm mt-1">
              <a href={`tel:${c.phoneLink}`} class="text-brand hover:underline">{c.phone}</a>
            </p>
          </div>
        ))}
      </div>

      <!-- Static "Send Message" — mailto-powered -->
      <div class="rounded-xl border border-slate-200 p-8 bg-white">
        <h2 class="text-2xl font-bold mb-2">Send Message</h2>
        <p class="text-ink/80 mb-6">Fill in your name and message, we'll open your email app with everything filled in.</p>
        <form
          method="get"
          action="mailto:paritosh.segal@gmail.com"
          class="space-y-4"
          onsubmit="event.preventDefault(); const f=event.target; window.location.href='mailto:paritosh.segal@gmail.com?subject='+encodeURIComponent('Website enquiry from '+f.name.value)+'&body='+encodeURIComponent(f.message.value+'\n\n— '+f.name.value+'\n'+f.email.value);"
        >
          <div class="grid sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="text-sm font-semibold text-ink">Name</span>
              <input name="name" type="text" required class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
            </label>
            <label class="block">
              <span class="text-sm font-semibold text-ink">Email</span>
              <input name="email" type="email" required class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none" />
            </label>
          </div>
          <label class="block">
            <span class="text-sm font-semibold text-ink">Message</span>
            <textarea name="message" required rows="5" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 focus:border-brand focus:ring-1 focus:ring-brand outline-none"></textarea>
          </label>
          <button type="submit" class="btn-primary">Send</button>
        </form>
      </div>

      <!-- Follow Us -->
      <div class="rounded-xl border border-slate-200 p-6 bg-white">
        <h3 class="text-lg font-semibold mb-4">Follow Us</h3>
        <div class="flex gap-3">
          <a href="https://www.facebook.com/navsahyogfoundation/" target="_blank" rel="noopener" aria-label="Facebook" class="p-3 rounded-full bg-brand-50 text-brand hover:bg-brand hover:text-white transition">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M13 22v-8h2.8l.4-3.2H13V8.7c0-.9.3-1.6 1.6-1.6H16V4.2A22 22 0 0 0 13.9 4c-2.3 0-3.9 1.4-3.9 4v2.8H7.2V14H10v8h3Z"/></svg>
          </a>
          <a href="https://www.instagram.com/navsahyogfoundation/" target="_blank" rel="noopener" aria-label="Instagram" class="p-3 rounded-full bg-brand-50 text-brand hover:bg-brand hover:text-white transition">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.5 1s.8.9 1 1.5c.2.5.4 1.1.4 2.3.1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-1 1.5s-.9.8-1.5 1c-.5.2-1.1.4-2.3.4-1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.5-1s-.8-.9-1-1.5c-.2-.5-.4-1.1-.4-2.3C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.3-1.8.4-2.2.2-.6.5-1 1-1.5s.9-.8 1.5-1c.5-.2 1.1-.4 2.3-.4C8.4 2.2 8.8 2.2 12 2.2M12 0C8.7 0 8.3 0 7 .1 5.8.1 4.9.3 4.2.6c-.8.3-1.5.7-2.1 1.4S1 3.4.7 4.2c-.3.7-.5 1.6-.6 2.8C0 8.3 0 8.7 0 12s0 3.7.1 4.9c.1 1.3.3 2.1.6 2.9.3.8.7 1.5 1.4 2.1s1.3 1.1 2.1 1.4c.8.3 1.6.5 2.8.6 1.3.1 1.7.1 5 .1s3.7 0 4.9-.1c1.3-.1 2.1-.3 2.9-.6.8-.3 1.5-.7 2.1-1.4s1.1-1.3 1.4-2.1c.3-.8.5-1.6.6-2.9.1-1.3.1-1.7.1-4.9s0-3.7-.1-4.9c-.1-1.3-.3-2.1-.6-2.9-.3-.8-.7-1.5-1.4-2.1s-1.3-1.1-2.1-1.4c-.8-.3-1.6-.5-2.9-.6C15.7 0 15.3 0 12 0zm0 5.8A6.2 6.2 0 1 0 18.2 12 6.2 6.2 0 0 0 12 5.8zm0 10.2A4 4 0 1 1 16 12a4 4 0 0 1-4 4zm6.4-11.8a1.4 1.4 0 1 0 1.4 1.4 1.4 1.4 0 0 0-1.4-1.4z"/></svg>
          </a>
          <a href="https://www.youtube.com/channel/UCOzO0-ZWLIOWjxU2SWwr7OA" target="_blank" rel="noopener" aria-label="YouTube" class="p-3 rounded-full bg-brand-50 text-brand hover:bg-brand hover:text-white transition">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/navsahyog-foundation/" target="_blank" rel="noopener" aria-label="LinkedIn" class="p-3 rounded-full bg-brand-50 text-brand hover:bg-brand hover:text-white transition">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.1a4.2 4.2 0 0 1 3.8-2.1c4 0 4.8 2.6 4.8 6V21h-4v-5.8c0-1.4 0-3.1-1.9-3.1-1.9 0-2.2 1.5-2.2 3V21h-4V9Z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <aside class="lg:col-span-2 space-y-6">
      <div class="rounded-xl bg-brand text-white p-6">
        <h3 class="text-lg font-semibold mb-3">Ways to support</h3>
        <ul class="space-y-2 text-white/90">
          <li>• Donate online in minutes</li>
          <li>• Sponsor a village cohort</li>
          <li>• Partner as a company or family foundation</li>
          <li>• Volunteer your skills (writing, design, audit, mentorship)</li>
        </ul>
        <a href={url('/donate/')} class="btn bg-white text-brand hover:bg-white/90 mt-5">Donate now</a>
      </div>

      <div class="rounded-xl bg-surface-soft p-6 border border-slate-200">
        <h3 class="text-lg font-semibold mb-3">Registered as</h3>
        <p class="text-ink/80 text-sm leading-relaxed">
          NavSahyog Foundation is a Section 8, not-for-profit company, registered in India.
          Donations are eligible for tax deduction under Section 80G. FCRA-registered for
          international donations.
        </p>
      </div>
    </aside>
  </div>
</Layout>
