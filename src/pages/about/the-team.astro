---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Img from '../../components/Img.astro';
import {
  advisors, founders, functionalLeaders, programTeam,
  facilitatorsBengaluru, facilitatorsDimapur, facilitatorsHills, facilitatorsLegacy,
  teamArchivePhotos,
} from '../../data/team';

const sections = [
  { heading: 'Board of Advisors', members: advisors },
  { heading: 'Co-Founders', members: founders },
  { heading: 'Functional Leaders', members: functionalLeaders },
  { heading: 'Programme Team', members: programTeam },
];

const facilitatorGroups = [
  { heading: 'Bengaluru · Karnataka', list: facilitatorsBengaluru },
  { heading: 'Dimapur · Nagaland', list: facilitatorsDimapur },
  { heading: 'Jawadhu Hills · Tamil Nadu', list: facilitatorsHills },
  { heading: 'Tamil Nadu &amp; Karnataka roster', list: facilitatorsLegacy },
];
---

<Layout title="The Team" description="Advisors, founders, leaders and 150+ Area Facilitators who run NavSahyog Foundation's daily programme across Karnataka, Tamil Nadu and Nagaland.">
  <PageHeader
    eyebrow="About"
    title="The people who make this work."
    accentWord="people"
    subtitle="Advisors, founders, functional leaders and 150+ Area Facilitators — almost all women from the villages they serve."
  />

  <div class="container-content py-12 space-y-20">
    {sections.map((group) => (
      <section>
        <div class="flex items-end justify-between gap-6 mb-8 pb-4 border-b border-ink">
          <div class="eyebrow m-0"><span>{group.heading}</span></div>
          <div class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-3">{group.members.length} {group.members.length === 1 ? 'member' : 'members'}</div>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-8">
          {group.members.map((m) => (
            <div class="border-t border-line pt-5 flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-paper-alt text-accent font-semibold font-mono text-sm flex items-center justify-center shrink-0 border border-line">
                {m.name.split(' ').map((w) => w[0]).slice(0, 2).join('')}
              </div>
              <div>
                <div class="display text-lg leading-tight tracking-display-tight">{m.name}</div>
                <div class="text-[13px] text-ink-3 mt-1">{m.role}</div>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}

    <section>
      <div class="flex items-end justify-between gap-6 mb-3 pb-4 border-b border-ink">
        <div class="eyebrow m-0"><span>Area Facilitators</span></div>
        <div class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-3">150+ across three states</div>
      </div>
      <p class="text-base text-ink-2 max-w-3xl mb-12 leading-relaxed">
        Our on-ground leaders — women, almost all from the villages they serve — who run the daily programme Monday through Saturday, every week of the year.
      </p>
      <div class="space-y-14">
        {facilitatorGroups.map((g) => (
          <div>
            <h3 class="display text-xl md:text-2xl font-medium tracking-display-tight mb-6" set:html={g.heading} />
            <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-4">
              {g.list.map((f) => (
                <div class="text-center">
                  <Img src={f.photo} alt={f.name} class="w-full aspect-square object-cover rounded-full bg-paper-alt" />
                  <p class="mt-2.5 text-[12px] font-medium text-ink leading-tight">{f.name}</p>
                  {f.village && <p class="text-[10px] text-ink-3 mt-0.5">{f.village}</p>}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section>
      <div class="flex items-end justify-between gap-6 mb-8 pb-4 border-b border-ink">
        <div class="eyebrow m-0"><span>Team gatherings &amp; training</span></div>
      </div>
      <div class="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-7 lg:grid-cols-9 gap-2">
        {teamArchivePhotos.map((p) => (
          <Img src={p} alt="Team gathering" class="w-full aspect-square object-cover bg-paper-alt" />
        ))}
      </div>
    </section>
  </div>
</Layout>
