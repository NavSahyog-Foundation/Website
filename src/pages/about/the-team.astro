---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Img from '../../components/Img.astro';
import {
  advisors, founders, functionalLeaders, programTeam,
  facilitatorsBengaluru, facilitatorsDimapur, facilitatorsHills, facilitatorsLegacy,
  teamArchivePhotos,
} from '../../data/team';

const sections = [
  { heading: 'Board of Advisors', members: advisors },
  { heading: 'Founders', members: founders },
  { heading: 'Functional Leaders', members: functionalLeaders },
  { heading: 'Program Team', members: programTeam },
];

const facilitatorGroups = [
  { heading: 'Area Facilitators — Bengaluru (Karnataka)', list: facilitatorsBengaluru },
  { heading: 'Area Facilitators — Dimapur (Nagaland)', list: facilitatorsDimapur },
  { heading: 'Area Facilitators — Jawadhu Hills (Tamil Nadu)', list: facilitatorsHills },
  { heading: 'Area Facilitators — Tamil Nadu & Karnataka Roster', list: facilitatorsLegacy },
];
---

<Layout title="The Team" description="Advisors, founders, leaders and 150+ Area Facilitators who run NavSahyog Foundation's daily programme across Karnataka, Tamil Nadu and Nagaland.">
  <PageHeader
    eyebrow="About"
    title="The Team"
    subtitle="Advisors, founders, leaders and 150+ Area Facilitators — each one making the daily programme possible."
  />

  <div class="container-content py-16 space-y-14">
    {sections.map((group) => (
      <section>
        <h2 class="text-2xl md:text-3xl font-bold mb-6">{group.heading}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {group.members.map((m) => (
            <div class="rounded-xl border border-slate-200 p-5 bg-white shadow-sm flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-brand-50 text-brand font-semibold flex items-center justify-center shrink-0">
                {m.name.split(' ').map((w) => w[0]).slice(0, 2).join('')}
              </div>
              <div>
                <p class="font-semibold text-ink">{m.name}</p>
                <p class="text-sm text-ink/70 mt-0.5">{m.role}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}

    <section>
      <h2 class="text-2xl md:text-3xl font-bold mb-2">Area Facilitators (AF)</h2>
      <p class="text-ink/70 mb-8 max-w-3xl">
        Our on-ground leaders — women, almost all from the villages they serve — who run the daily
        programme Monday through Saturday, every week of the year.
      </p>
      <div class="space-y-12">
        {facilitatorGroups.map((g) => (
          <div>
            <h3 class="text-xl font-semibold mb-5 text-brand">{g.heading}</h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
              {g.list.map((f) => (
                <div class="text-center">
                  <Img src={f.photo} alt={f.name} class="w-full aspect-square object-cover rounded-full border-2 border-white shadow-sm bg-brand-50" />
                  <p class="mt-2 font-semibold text-ink text-xs">{f.name}</p>
                  {f.village && <p class="text-[10px] text-ink/60">{f.village}</p>}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h3 class="text-xl font-semibold mb-5 text-brand">Team gatherings &amp; training</h3>
      <div class="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-7 lg:grid-cols-9 gap-2">
        {teamArchivePhotos.map((p) => (
          <Img src={p} alt="Team gathering" class="w-full aspect-square object-cover rounded-lg" />
        ))}
      </div>
    </section>
  </div>
</Layout>
