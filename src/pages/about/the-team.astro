---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { teamGroups } from '../../data/team';
---

<Layout title="The Team" description="Meet the advisors, leaders and facilitators of NavSahyog Foundation.">
  <PageHeader
    eyebrow="About"
    title="The Team"
    subtitle="Advisors, leaders and on-ground facilitators who make every programme possible."
  />

  <div class="container-content py-16 space-y-16">
    {teamGroups.map((group) => (
      <section>
        <div class="mb-6">
          <h2 class="text-2xl md:text-3xl font-bold">{group.heading}</h2>
          {group.description && (
            <p class="text-ink/70 mt-2 max-w-2xl">{group.description}</p>
          )}
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {group.members.map((m) => (
            <div class="rounded-xl border border-slate-200 p-5 bg-white shadow-sm">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-full bg-brand-50 text-brand font-semibold flex items-center justify-center shrink-0">
                  {m.name.split(' ').map((w) => w[0]).slice(0, 2).join('')}
                </div>
                <div>
                  <p class="font-semibold text-ink">{m.name}</p>
                  <p class="text-sm text-ink/70 mt-0.5">{m.role}</p>
                  {m.region && (
                    <p class="text-xs text-brand mt-1 font-medium">{m.region}</p>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>
