---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../utils/url';

const domestic = [
  ['Name', 'Navsahyog Foundation'],
  ['Bank', 'ICICI Bank'],
  ['Account Number', '107505003198'],
  ['IFSC Code', 'ICIC0001075'],
  ['Google Pay / UPI', 'navsahyog01@icici'],
];

const foreign = [
  ['Name', 'Navsahyog Foundation'],
  ['Bank', 'State Bank of India'],
  ['Account Number', '42219241823'],
  ['Branch', 'New Delhi Main Branch'],
  ['Branch Address', '11, Parliament Street, New Delhi, NCT of Delhi – 110001'],
  ['IFSC Code', 'SBIN0000691'],
  ['MICR Code', '110002087'],
  ['SWIFT Code', 'SBININBB104'],
];

const cheque = [
  ['Email', 'donations.navsahyog@gmail.com'],
  ['Subject', 'Donations to Navsahyog'],
  ['Include', 'Name, address, PAN number, amount'],
];

const monoKeys = /Account|IFSC|SWIFT|MICR|UPI|Email/;

const impactStats = [
  { eyebrow: 'Reach · today', value: '350', plus: true, desc: 'Villages across Karnataka, Tamil Nadu and Nagaland — each one chosen for its remoteness.' },
  { eyebrow: 'Children · engaged daily', value: '10,000', plus: true, desc: 'Girls and boys, ages 5–14, receiving life-skills sessions Monday through Saturday, all year.' },
  { eyebrow: 'Mission · 2030', value: '1,00,000', plus: false, desc: 'Children with life skills — our target by 2030. Every gift closes the gap between here and there.' },
];
---

<Layout title="Donate" description="Donate to NavSahyog Foundation — life skills to livelihood for village children. 80G-eligible for Indian donors; FCRA-registered for international giving.">
  <PageHeader
    eyebrow="Support our work"
    title="Every gift becomes a day in a child's life."
    accentWord="a day"
    subtitle="80G-eligible for Indian donors. FCRA-registered for international. Audited yearly. Reported quarterly."
  />

  <!-- Call for donation -->
  <section class="bg-ink text-paper section-y">
    <div class="container-content">
      <div class="max-w-4xl mx-auto text-center mb-16 md:mb-20">
        <div class="eyebrow eyebrow-center mb-5"><span>Why give</span></div>
        <h2 class="display text-fluid-5 leading-[0.97] tracking-display-tight m-0 mb-8 text-paper">
          A child needs<br />
          <span class="display-italic text-accent">₹6.57 a day</span><br />
          to change their life.
        </h2>
        <p class="text-17 md:text-lg leading-relaxed text-paper/75 max-w-2xl mx-auto mb-10">
          That is the full cost of one child's year-round programme — sport, storytelling, creativity, and life skills, six days a week, every week. Our 2025–26 impact survey of 18,487 stakeholders found <strong class="text-paper">75% rate the change as High to Very High</strong>. No school fees. No conditions. Just daily presence in the village.
        </p>
        <a href="#choose-your-impact" class="bg-accent text-white px-8 py-4 rounded-full text-base font-semibold hover:bg-accent-deep hover:-translate-y-px transition-all inline-block">
          Give today →
        </a>
      </div>

      <!-- Three impact stats -->
      <div class="grid sm:grid-cols-3 gap-px bg-paper/10 border border-paper/10">
        {impactStats.map((s) => (
          <div class="bg-ink px-8 py-10">
            <div class="label-mono tracking-label-16 text-accent mb-4">{s.eyebrow}</div>
            <div class="display text-fluid-6 leading-none tracking-display-tighter text-paper mb-3">
              {s.value}{s.plus && <span class="text-accent">+</span>}
            </div>
            <p class="text-14 text-paper/65 leading-snug m-0">{s.desc}</p>
          </div>
        ))}
      </div>

      <!-- Trust strip -->
      <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 items-center justify-center pt-8 border-t border-paper/10">
        <span class="label-mono tracking-label-16 text-paper/40">Giving assurance</span>
        {['Section 8 Company', '80G tax-exempt', 'FCRA #094421912', 'Audited annually', 'Reported quarterly'].map((b) => (
          <span class="chip text-paper/60">{b}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Choose your impact -->
  <section id="choose-your-impact" class="section-y-sm">
    <div class="container-content">
      <div class="eyebrow"><span>Choose your impact</span></div>
      <h2 class="display text-fluid-9 leading-[1.05] tracking-display-tight m-0 mb-3">
        Pick a tier — or <span class="display-italic text-accent">any amount</span>.
      </h2>
      <p class="text-base text-ink-2 m-0 mb-10 max-w-2xl">
        All tiers automatically generate an 80G receipt for Indian PAN holders. International donors should use the FCRA bank account further down.
      </p>

      <!-- Tier picker -->
      <div data-tier-grid class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
        {[
          { amt: 600, label: 'Quarter year', desc: 'Sustains one child for 3 months' },
          { amt: 2400, label: 'Full year', desc: 'One child, every day, all year', popular: true },
          { amt: 24000, label: 'Cohort', desc: 'A 10-child village cohort for a year' },
          { amt: 240000, label: 'Cluster', desc: 'A 100-child village cluster' },
        ].map((t) => (
          <button
            type="button"
            data-tier
            data-amount={t.amt}
            aria-pressed={t.popular ? 'true' : 'false'}
            class:list={['tier', t.popular && 'is-selected']}
          >
            {t.popular && (
              <div class="absolute top-3 right-3 font-mono text-eyebrow-sm uppercase tracking-label-10 font-bold bg-accent text-white px-2 py-1">
                Most given
              </div>
            )}
            <div class="label-mono tracking-label-12 opacity-70 mb-3">{t.label}</div>
            <div class="display text-3xl md:text-4xl font-medium tracking-display-tight leading-none mb-2">
              ₹{t.amt.toLocaleString('en-IN')}
            </div>
            <div class="text-13 leading-snug opacity-80">{t.desc}</div>
          </button>
        ))}
      </div>

      <!-- Custom + frequency + CTA -->
      <div class="mt-6 grid md:grid-cols-3 gap-4 items-center">
        <div class="flex items-center border-[1.5px] border-ink rounded-full overflow-hidden">
          <span class="px-4 py-3.5 bg-paper-alt font-semibold border-r border-ink">₹</span>
          <input
            data-custom-amount
            type="text"
            inputmode="numeric"
            placeholder="Other amount"
            class="flex-1 px-4 py-3.5 border-0 bg-transparent outline-none font-medium text-15"
            aria-label="Custom amount"
          />
        </div>
        <div class="flex gap-6 text-sm justify-center md:justify-start">
          <label class="inline-flex items-center gap-2 cursor-pointer">
            <input type="radio" name="freq" value="onetime" checked class="accent-accent" /> One time
          </label>
          <label class="inline-flex items-center gap-2 cursor-pointer">
            <input type="radio" name="freq" value="monthly" class="accent-accent" /> Monthly
          </label>
        </div>
        <a
          data-cta
          href="https://navsahyog-foundation.danamojo.org/"
          target="_blank"
          rel="noopener"
          class="btn-primary px-7 py-4 text-base"
        >
          Continue to payment →
        </a>
      </div>

      <!-- Pay via -->
      <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 items-center justify-center pt-8 border-t border-line">
        <span class="label-mono tracking-label-16 text-ink-3">Pay via</span>
        <a href="https://navsahyog-foundation.danamojo.org/" target="_blank" rel="noopener" class="text-sm font-medium text-ink hover:text-accent">Danamojo</a>
        <a href="https://give.do/ngos/navsahyog-foundation" target="_blank" rel="noopener" class="text-sm font-medium text-ink hover:text-accent">Give.do</a>
        <span class="text-sm text-ink-2">UPI</span>
        <span class="text-sm text-ink-2">NEFT/RTGS</span>
        <span class="text-sm text-ink-2">Cheque</span>
      </div>
      <p class="mt-6 text-13 text-ink-3 text-center max-w-2xl mx-auto">
        Picking a tier is optional — "Continue to payment" takes you to Danamojo, where you'll confirm your amount and frequency.
      </p>
    </div>
  </section>

  <script is:inline>
    (() => {
      const tiers = document.querySelectorAll('[data-tier]');
      const customAmt = document.querySelector('[data-custom-amount]');
      const cta = document.querySelector('[data-cta]');
      const base = cta ? cta.href.split('?')[0] : '';

      // Reflect the chosen amount + frequency in the payment link so the
      // selection isn't discarded. Danamojo ignores params it doesn't use, so
      // this is harmless even if it doesn't pre-fill from the query string.
      const currentAmount = () => {
        const custom = (customAmt?.value || '').replace(/[^0-9]/g, '');
        if (custom) return custom;
        const sel = document.querySelector('[data-tier].is-selected');
        return sel ? sel.getAttribute('data-amount') || '' : '';
      };
      const currentFreq = () =>
        document.querySelector('input[name="freq"]:checked')?.value || 'onetime';
      const updateCta = () => {
        if (!cta) return;
        const params = new URLSearchParams();
        const amount = currentAmount();
        if (amount) params.set('amount', amount);
        params.set('frequency', currentFreq());
        const qs = params.toString();
        cta.href = qs ? `${base}?${qs}` : base;
      };

      const select = (btn) => {
        tiers.forEach((t) => {
          t.classList.remove('is-selected');
          t.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-selected');
        btn.setAttribute('aria-pressed', 'true');
        if (customAmt) customAmt.value = '';
        updateCta();
      };
      tiers.forEach((t) => t.addEventListener('click', () => select(t)));
      customAmt?.addEventListener('input', () => {
        if (customAmt.value.trim()) {
          tiers.forEach((t) => {
            t.classList.remove('is-selected');
            t.setAttribute('aria-pressed', 'false');
          });
        }
        updateCta();
      });
      document
        .querySelectorAll('input[name="freq"]')
        .forEach((r) => r.addEventListener('change', updateCta));
      updateCta();
    })();
  </script>

  <!-- Bank details -->
  <section class="section-y-sm border-t border-line">
    <div class="container-content grid lg:grid-cols-[1.4fr_1fr] gap-16">
      <div>
        <div class="eyebrow"><span>Direct transfer</span></div>
        <h3 class="display text-3xl md:text-32 tracking-display-tight m-0 mb-10">Wire / UPI / Cheque</h3>

        <div class="border-t border-line">
          <!-- Domestic -->
          <div class="py-7 border-b border-line grid sm:grid-cols-[200px_1fr] gap-6 sm:gap-8">
            <div>
              <div class="label-mono tracking-label-14 text-ink-3 mb-1.5">Domestic — INR</div>
              <div class="display text-lg font-semibold">ICICI Bank</div>
            </div>
            <dl class="grid sm:grid-cols-2 gap-y-2 gap-x-6 m-0 text-14">
              {domestic.map(([k, v]) => (
                <div class="contents">
                  <dt class="text-ink-3">{k}</dt>
                  <dd class={`text-ink font-medium m-0 ${monoKeys.test(k) ? 'font-mono text-13' : ''}`}>{v}</dd>
                </div>
              ))}
            </dl>
          </div>

          <!-- FCRA -->
          <div class="py-7 border-b border-line grid sm:grid-cols-[200px_1fr] gap-6 sm:gap-8">
            <div>
              <div class="label-mono tracking-label-14 text-ink-3 mb-1.5">International — FCRA</div>
              <div class="display text-lg font-semibold">State Bank of India</div>
            </div>
            <dl class="grid sm:grid-cols-2 gap-y-2 gap-x-6 m-0 text-14">
              {foreign.map(([k, v]) => (
                <div class="contents">
                  <dt class="text-ink-3">{k}</dt>
                  <dd class={`text-ink font-medium m-0 ${monoKeys.test(k) ? 'font-mono text-13' : ''}`}>{v}</dd>
                </div>
              ))}
            </dl>
          </div>

          <!-- Cheque -->
          <div class="py-7 border-b border-line grid sm:grid-cols-[200px_1fr] gap-6 sm:gap-8">
            <div>
              <div class="label-mono tracking-label-14 text-ink-3 mb-1.5">By cheque</div>
              <div class="display text-lg font-semibold">Email us first</div>
            </div>
            <dl class="grid sm:grid-cols-2 gap-y-2 gap-x-6 m-0 text-14">
              {cheque.map(([k, v]) => (
                <div class="contents">
                  <dt class="text-ink-3">{k}</dt>
                  <dd class={`text-ink font-medium m-0 ${monoKeys.test(k) ? 'font-mono text-13' : ''}`}>
                    {k === 'Email' ? <a href={`mailto:${v}`} class="hover:text-accent">{v}</a> : v}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </div>

      <aside class="space-y-4">
        <div class="bg-accent text-white p-7">
          <div class="label-mono tracking-label-14 mb-3 text-white/85">Section 80G</div>
          <p class="text-14 leading-relaxed m-0 mb-3 text-white/95">
            Indian donors receive a tax-deduction receipt under Section 80G of the Income Tax Act, 1961.
          </p>
          <p class="font-mono text-eyebrow tracking-wider text-white/80 m-0">
            Provisional Approval: AAGCN8813PF20206<br />
            Valid AY 2022-23 to AY 2026-27
          </p>
        </div>
        <div class="bg-white border border-line p-7">
          <div class="label-mono tracking-label-14 text-accent mb-3">FCRA Registration</div>
          <p class="text-14 leading-relaxed m-0 mb-3 text-ink-2">
            Authorized to receive foreign contributions. As per Government of India regulations, please make
            international donations <strong>only to the FCRA bank account</strong> — they cannot be accepted via
            domestic bank, UPI, or Google Pay.
          </p>
          <p class="font-mono text-eyebrow tracking-wider text-ink-3 m-0">FCRA #094421912</p>
        </div>
        <div class="bg-white border border-line p-7">
          <div class="label-mono tracking-label-14 text-accent mb-3">Major gifts &amp; CSR</div>
          <p class="text-14 leading-relaxed m-0 mb-3 text-ink-2">
            For corporate CSR, large donations, or partnership conversations, please write to Paritosh.
          </p>
          <a href="mailto:paritosh.segal@gmail.com" class="font-mono text-eyebrow-lg tracking-wide text-accent hover:text-accent-deep">paritosh.segal@gmail.com</a>
        </div>
      </aside>
    </div>
  </section>

  <!-- Transparency -->
  <section class="section-y bg-paper-alt border-t border-line">
    <div class="container-content grid md:grid-cols-[1fr_1.4fr] gap-16 lg:gap-24 items-start">
      <div>
        <div class="eyebrow"><span>Transparency</span></div>
        <h2 class="display text-fluid-9 leading-[1.02] tracking-display-tight m-0 mb-7">
          Every rupee, accounted for.
        </h2>
        <p class="text-base leading-relaxed text-ink-2 max-w-md">
          Each year we publish audited finances and an independent annual impact study. All available for download — no signup required.
        </p>
      </div>
      <div>
        <div class="grid gap-3 mb-10">
          {[
            ['Annual Reports', '2024-25, 2023-24, 2022-23, 2021-22'],
            ['Audited Financials', 'Same years, side-by-side'],
            ['Impact Studies', '2026, 2025, 2024, 2023, 2022, 2021'],
            ['Research Reports', 'Sport · Storytelling · Music & Art'],
          ].map(([k, v]) => (
            <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 py-4 border-b border-line">
              <div class="display text-xl md:text-2xl tracking-display-tight sm:min-w-[180px]">{k}</div>
              <div class="text-sm text-ink-2">{v}</div>
            </div>
          ))}
        </div>
        <a href={url('/downloads/')} class="link-arrow font-semibold">
          Browse all downloads <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
