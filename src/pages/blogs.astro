---

<Layout title="Blogs" description="Stories, videos, reflections and field notes from NavSahyog Foundation — from 2021 to today.">
  <PageHeader eyebrow="From the field" title="Blogs" subtitle="Stories and reflections from our villages and our team." />

  <div class="container-content py-16">
    <h2 class="text-2xl md:text-3xl font-bold mb-6">Latest Videos</h2>
    <div class="space-y-5 mb-16">
      {currentPosts.map((p) => (
        <a href={p.video} target="_blank" rel="noopener" class="group flex flex-col sm:flex-row rounded-xl border border-slate-200 bg-white hover:border-brand hover:bg-brand-50 transition overflow-hidden">
          <div class="sm:w-64 shrink-0 aspect-video sm:aspect-auto">
            <WpImage src={p.image} alt={p.title} class="w-full h-full object-cover" />
          </div>
          <div class="p-6 flex-1">
            <p class="text-xs uppercase tracking-wide text-brand font-semibold">{p.date}</p>
            <h3 class="text-xl font-bold mt-1 mb-2">▶ {p.title}</h3>
            <p class="text-ink/80">{p.summary}</p>
            <p class="mt-3 text-sm text-brand font-semibold">Watch on YouTube →</p>
          </div>
        </a>
      ))}
    </div>

    <h2 class="text-2xl md:text-3xl font-bold mb-6">Archive</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
      {archivePosts.map((p) => (
        <figure class="rounded-lg overflow-hidden bg-white border border-slate-200">
          <div class="aspect-[4/3]">
            <WpImage src={p.image} alt={p.title} class="w-full h-full object-cover" />
          </div>
          <figcaption class="px-3 py-2 text-xs text-ink/80">{p.title}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</Layout>
