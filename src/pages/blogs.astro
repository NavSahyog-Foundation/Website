---

<Layout title="Blogs" description="Stories, videos, reflections and field notes from NavSahyog Foundation — from 2021 to today.">
  <PageHeader eyebrow="From the field" title="Blogs" subtitle="Stories and reflections from our villages and our team." />

  <div class="container-content py-16">
    <h2 class="text-2xl md:text-3xl font-bold mb-6">Featured Report</h2>
    <article class="mb-16 rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-sm">
      <div class="grid md:grid-cols-2 gap-0">
        <a href={url(impactStudy.pdf)} target="_blank" rel="noopener" class="block group">
          <div class="aspect-video md:aspect-auto md:h-full bg-slate-100">
            <Img src={impactStudy.cover} alt={`${impactStudy.title} cover`} class="w-full h-full object-cover group-hover:opacity-95 transition" loading="eager" />
          </div>
        </a>
        <div class="p-6 md:p-8 flex flex-col">
          <p class="text-xs uppercase tracking-wide text-brand font-semibold">{impactStudy.date} · Impact Study</p>
          <h3 class="text-2xl md:text-3xl font-bold mt-1 mb-3">{impactStudy.title}</h3>
          <p class="text-ink/80 mb-5">
            Our largest impact survey to date — independent ratings from <strong>6,388 children, 6,294 parents and 5,805 teachers</strong> across the villages where the NavSahyog Foundation programme has been active for six months or more. The headline: the programme delivers <strong>universal, consistent, age-resilient positive change</strong>.
          </p>

          <div class="grid grid-cols-3 gap-3 mb-6">
            {impactStudy.stats.map((s) => (
              <div class="rounded-lg bg-brand-50 border border-brand/20 p-3 text-center">
                <p class="text-xl md:text-2xl font-bold text-brand leading-tight">{s.value}</p>
                <p class="text-[11px] md:text-xs text-ink/70 mt-1 leading-snug">{s.label}</p>
              </div>
            ))}
          </div>

          <h4 class="font-semibold text-ink mb-2">Key highlights</h4>
          <ul class="space-y-2 text-sm text-ink/80 mb-6 list-disc pl-5">
            {impactStudy.highlights.map((h) => (
              <li set:html={h} />
            ))}
          </ul>

          <div class="mt-auto flex flex-wrap gap-3">
            <a href={url(impactStudy.pdf)} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-brand text-white font-semibold hover:opacity-90 transition">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Download the full report (PDF)
            </a>
            <a href={url('/downloads')} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-slate-300 text-ink font-semibold hover:border-brand hover:text-brand transition">
              See all impact reports →
            </a>
          </div>
        </div>
      </div>
    </article>

    <h2 class="text-2xl md:text-3xl font-bold mb-6">Featured Story</h2>
    <a href={url(featuredPost.href)} class="group flex flex-col sm:flex-row rounded-xl border border-brand/30 bg-brand-50 hover:border-brand hover:bg-white transition overflow-hidden mb-16 shadow-sm">
      <div class="sm:w-80 shrink-0 aspect-video sm:aspect-auto">
        <Img src={featuredPost.image} alt={featuredPost.title} class="w-full h-full object-cover" loading="eager" />
      </div>
      <div class="p-6 flex-1">
        <p class="text-xs uppercase tracking-wide text-brand font-semibold">{featuredPost.date} · Award</p>
        <h3 class="text-xl md:text-2xl font-bold mt-1 mb-2">🏆 {featuredPost.title}</h3>
        <p class="text-ink/80">{featuredPost.summary}</p>
        <p class="mt-3 text-sm text-brand font-semibold">Read the story →</p>
      </div>
    </a>

    <h2 class="text-2xl md:text-3xl font-bold mb-6">Latest Videos</h2>
    <div class="space-y-5 mb-16">
      {currentPosts.map((p) => (
        <a href={p.video} target="_blank" rel="noopener" class="group flex flex-col sm:flex-row rounded-xl border border-slate-200 bg-white hover:border-brand hover:bg-brand-50 transition overflow-hidden">
          <div class="sm:w-64 shrink-0 aspect-video sm:aspect-auto">
            <Img src={p.image} alt={p.title} class="w-full h-full object-cover" />
          </div>
          <div class="p-6 flex-1">
            <p class="text-xs uppercase tracking-wide text-brand font-semibold">{p.date}</p>
            <h3 class="text-xl font-bold mt-1 mb-2">▶ {p.title}</h3>
            <p class="text-ink/80">{p.summary}</p>
            <p class="mt-3 text-sm text-brand font-semibold">Watch on YouTube →</p>
          </div>
        </a>
      ))}
    </div>

    <h2 class="text-2xl md:text-3xl font-bold mb-6">Archive</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
      {archivePosts.map((p) => (
        <figure class="rounded-lg overflow-hidden bg-white border border-slate-200">
          <div class="aspect-[4/3]">
            <Img src={p.image} alt={p.title} class="w-full h-full object-cover" />
          </div>
          <figcaption class="px-3 py-2 text-xs text-ink/80">{p.title}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</Layout>
